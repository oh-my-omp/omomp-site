---
import "../styles/global.css";
import "../styles/slices.css";
import Logo from "../components/Logo.astro";
import { href, routeOf, t, type Lang } from "../i18n";
import { nav, org, ui } from "../ui";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Candidate pages that search engines must not list. */
  noindex?: boolean;
}

const { lang, title, description, noindex = false } = Astro.props;
const route = routeOf(Astro.url.pathname);
const other: Lang = lang === "en" ? "zh" : "en";
const fullTitle = route === "/" ? title : `${title} · oh-my-omp`;
const canonical = new URL(href(route, lang), Astro.site).href;
const alternate = (l: Lang) => new URL(href(route, l), Astro.site).href;
---

<!doctype html>
<html lang={lang === "zh" ? "zh-CN" : "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={alternate("en")} />
    <link rel="alternate" hreflang="zh-CN" href={alternate("zh")} />
    <link rel="alternate" hreflang="x-default" href={alternate("en")} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#08090a" />
  </head>
  <body>
    <a class="skip" href="#main">{t(ui.skip, lang)}</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={href("/", lang)} aria-label="oh-my-omp">
          <Logo size={20} />
          <span>oh-my-omp</span>
        </a>
        <nav class="nav" aria-label="Primary">
          {
            nav.map((item) => (
              <a href={href(item.route, lang)} class:list={[{ on: route.startsWith(item.match ?? item.route) }]}>
                {t(item.label, lang)}
              </a>
            ))
          }
        </nav>
        <div class="tools">
          <a class="lang" href={href(route, other)} hreflang={other === "zh" ? "zh-CN" : "en"} lang={other === "zh" ? "zh-CN" : "en"}>
            {t(ui.switchLang, lang)}
          </a>
          <a class="gh" href={org} aria-label="GitHub">
            <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
            </svg>
          </a>
          <details class="menu">
            <summary aria-label="Menu">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
                <path d="M3 6h12M3 12h12"></path>
              </svg>
            </summary>
            <div class="menu-panel">
              {nav.map((item) => <a href={href(item.route, lang)}>{t(item.label, lang)}</a>)}
            </div>
          </details>
        </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap foot">
        <div class="foot-brand">
          <Logo size={16} />
          <span>oh-my-omp</span>
        </div>
        <nav class="foot-nav" aria-label="Footer">
          {nav.map((item) => <a href={href(item.route, lang)}>{t(item.label, lang)}</a>)}
          <a href={org}>GitHub</a>
        </nav>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: 16px;
    top: 12px;
    z-index: 100;
    padding: 8px 12px;
    background: var(--text);
    color: var(--bg);
    border-radius: 8px;
  }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: saturate(180%) blur(14px);
    -webkit-backdrop-filter: saturate(180%) blur(14px);
    background: rgb(8 9 10 / 0.8);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 28px;
    height: 64px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    font-size: 15px;
    letter-spacing: -0.01em;
  }
  .nav {
    display: flex;
    gap: 2px;
    margin-left: auto;
  }
  .nav a {
    font-size: 14px;
    color: var(--muted);
    padding: 6px 10px;
    border-radius: 8px;
    transition: color 0.15s, background 0.15s;
  }
  .nav a:hover,
  .nav a.on {
    color: var(--text);
    background: rgb(255 255 255 / 0.05);
  }
  .tools {
    margin-left: 12px;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .lang {
    font-size: 13px;
    color: var(--muted);
    padding: 4px 10px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
  }
  .lang:hover,
  .gh:hover {
    color: var(--text);
  }
  .gh {
    color: var(--muted);
    display: inline-flex;
  }
  .site-footer {
    border-top: 1px solid var(--line);
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-block: 36px;
    color: var(--dim);
    font-size: 13px;
  }
  .foot-brand {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
  }
  .foot-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
  }
  .foot-nav a:hover {
    color: var(--text);
  }
  @media (max-width: 480px) {
    .foot-nav {
      display: grid;
      grid-template-columns: repeat(3, auto);
      justify-content: start;
      gap: 10px 24px;
    }
  }
  .menu {
    display: none;
    position: relative;
  }
  .menu summary {
    list-style: none;
    cursor: pointer;
    color: var(--muted);
    display: inline-flex;
    padding: 4px;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 12px);
    min-width: 200px;
    display: grid;
    padding: 8px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--bg-raised);
    box-shadow: 0 20px 50px -20px rgb(0 0 0 / 0.8);
  }
  .menu-panel a {
    padding: 10px 12px;
    border-radius: 8px;
    font-size: 15px;
  }
  .menu-panel a:hover {
    background: rgb(255 255 255 / 0.05);
  }
  @media (max-width: 760px) {
    .nav {
      display: none;
    }
    .menu {
      display: block;
    }
    .tools {
      margin-left: auto;
    }
  }
</style>
