---
import { getCollection } from "astro:content";
import RepairArt, { type RailStop } from "./RepairArt.astro";
import { repairArt, repairLines, repairListLines, type RepairCard, type RepairListed } from "../copy/preview";
import { repos, repoUrl } from "../data/repos";
import { emphasis, href, t, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

/**
 * Two rows of four: the runtime (two columns) with the two plugins a person meets first, then sessions and the three
 * products. The other plugins follow as one hairline list, as linear.app lists its smaller features.
 */
const order: readonly RepairCard[] = [
  "omp-config",
  "omp-ask-more",
  "omp-todo-more",
  "omp-sessions",
  "omp-playbooks",
  "omp-dispatch",
  "omp-remote-build",
];
const listed: readonly RepairListed[] = ["omp-unified-exec", "omp-peers", "omp-codex-image-gen"];
const target = (name: string) => {
  const repo = repos.find((r) => r.name === name);
  if (!repo) throw new Error(`\`${name}\` has no entry in src/data/repos.ts`);
  return repo.page ? href(repo.page, lang) : repoUrl(name);
};

const seams = (await getCollection("seams")).sort((a, b) => a.data.order - b.data.order);
/** The three things omp-config does to a call, each at one seam where it happens; later seams stand their tag higher. */
const marks: Readonly<Record<string, { text: string; stem: number }>> = {
  prompt: { text: t(repairArt.config.appends, lang), stem: 40 },
  execution: { text: t(repairArt.config.blocks, lang), stem: 90 },
  delivery: { text: t(repairArt.config.judges, lang), stem: 140 },
};
const rail: readonly RailStop[] = seams.map((s) => ({ label: s.data.short[lang], mark: marks[s.id] ?? null }));
---

<div class="bento">
  {
    order.map((name) => (
      <a class="card" data-repo={name} href={target(name)}>
        <div class="ct">
          <code class="name">{name}</code>
          <p set:html={emphasis(t(repairLines[name], lang))} />
        </div>
        <RepairArt name={name} lang={lang} rail={rail} />
      </a>
    ))
  }
</div>
<ul class="listed">
  {
    listed.map((name) => (
      <li>
        <a href={target(name)}>
          <code>{name}</code>
          <span>{t(repairListLines[name], lang)}</span>
          <i aria-hidden="true">+</i>
        </a>
      </li>
    ))
  }
</ul>

<style>
  /* Cards as on supabase.com: a name, one line, and under them one drawing that runs off the card's edge. */
  .bento {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }
  .card {
    --card: #0c0d0e;
    position: relative;
    display: block;
    height: 412px;
    min-width: 0;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--card);
    color: inherit;
    text-decoration: none;
    overflow: hidden;
    transition: border-color 0.15s;
  }
  .card:hover {
    border-color: var(--line-strong);
  }
  .card[data-repo="omp-config"] {
    grid-column: span 2;
  }
  .ct {
    position: relative;
    z-index: 1;
    display: grid;
    padding: 24px 24px 0;
  }
  .name {
    padding: 0;
    border: 0;
    background: none;
    font-size: 16px;
    line-height: 22px;
    color: var(--text);
    white-space: nowrap;
  }
  /* The line wraps where the measure ends, never at a fixed point. */
  .ct p {
    margin-top: 10px;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--muted);
    max-width: 30ch;
    text-wrap: pretty;
  }
  .ct p:lang(zh) {
    max-width: 19em;
  }
  .ct p :global(b) {
    font-weight: inherit;
    color: var(--text);
  }
  /* The smaller plugins: one row each between hairlines, name, one line and a plus, as linear.app's feature list. */
  .listed {
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .listed li {
    border-bottom: 1px solid var(--line);
  }
  .listed a {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 24px;
    padding: 16px 4px;
    color: inherit;
    text-decoration: none;
    transition: background 0.15s;
  }
  .listed a:hover {
    background: var(--bg-hover);
  }
  .listed code {
    padding: 0;
    border: 0;
    background: none;
    font-size: 14px;
    color: var(--text);
  }
  .listed span {
    font-size: 14.5px;
    color: var(--muted);
    text-wrap: pretty;
  }
  .listed i {
    font-style: normal;
    color: var(--muted);
  }

  @media (max-width: 1080px) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 680px) {
    .bento {
      grid-template-columns: minmax(0, 1fr);
    }
    .card,
    .card[data-repo="omp-config"] {
      grid-column: auto;
      height: auto;
      padding-bottom: 16px;
    }
    .ct {
      padding: 16px 20px 0;
    }
    .ct p {
      margin-top: 6px;
    }
    .listed a {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 4px 16px;
    }
    .listed span {
      grid-column: 1;
    }
    .listed i {
      grid-row: 1;
      grid-column: 2;
    }
  }
</style>
