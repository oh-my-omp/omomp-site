---
import { getCollection } from "astro:content";
import RepairArt, { type RailStop } from "./RepairArt.astro";
import { home } from "../copy/home";
import { repairArt, repairLines, type RepairCard } from "../copy/preview";
import { repos, repoUrl } from "../data/repos";
import { emphasis, href, t, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

/**
 * Row by row: the runtime with the two plugins a person meets first, the other plugins and the first product, then
 * the other two products and the tool. omp-remote-build takes two columns, so the last row is full.
 */
const order: readonly RepairCard[] = [
  "omp-config",
  "omp-ask-more",
  "omp-todo-more",
  "omp-unified-exec",
  "omp-sessions",
  "omp-peers",
  "omp-playbooks",
  "omp-dispatch",
  "omp-remote-build",
  "omp-codex-image-gen",
];
const cards = order.map((name) => {
  const repo = repos.find((r) => r.name === name);
  if (!repo) throw new Error(`card \`${name}\` has no entry in src/data/repos.ts`);
  return { name, kind: repo.kind, target: repo.page ? href(repo.page, lang) : repoUrl(name) };
});

const seams = (await getCollection("seams")).sort((a, b) => a.data.order - b.data.order);
/** The three things omp-config does to a call, each at one seam where it happens; later seams stand their tag higher. */
const marks: Readonly<Record<string, { text: string; stem: number }>> = {
  prompt: { text: t(repairArt.config.appends, lang), stem: 40 },
  execution: { text: t(repairArt.config.blocks, lang), stem: 90 },
  delivery: { text: t(repairArt.config.judges, lang), stem: 140 },
};
const rail: readonly RailStop[] = seams.map((s) => ({ label: s.data.short[lang], mark: marks[s.id] ?? null }));
---

<div class="bento">
  {
    cards.map((c) => (
      <a class="card" data-repo={c.name} href={c.target}>
        <div class="ct">
          <span class="kind">{t(home.blocks.kinds[c.kind], lang)}</span>
          <code class="name">{c.name}</code>
          <p set:html={emphasis(t(repairLines[c.name], lang))} />
        </div>
        <RepairArt name={c.name} lang={lang} rail={rail} />
      </a>
    ))
  }
</div>

<style>
  /* Cards as on supabase.com: a name, one line, and under them one drawing that runs off the card's edge. */
  .bento {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }
  .card {
    --card: #0c0d0e;
    position: relative;
    display: block;
    height: 412px;
    min-width: 0;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--card);
    color: inherit;
    text-decoration: none;
    overflow: hidden;
    transition: border-color 0.15s;
  }
  .card:hover {
    border-color: var(--line-strong);
  }
  .card[data-repo="omp-config"],
  .card[data-repo="omp-remote-build"] {
    grid-column: span 2;
  }
  .ct {
    position: relative;
    z-index: 1;
    display: grid;
    padding: 24px 24px 0;
  }
  .kind {
    font-size: 12px;
    line-height: 16px;
    color: var(--muted);
  }
  .name {
    margin-top: 6px;
    padding: 0;
    border: 0;
    background: none;
    font-size: 16px;
    line-height: 22px;
    color: var(--text);
    white-space: nowrap;
  }
  .ct p {
    margin-top: 10px;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--muted);
    max-width: 25em;
    text-wrap: balance;
  }
  .ct p :global(b) {
    font-weight: inherit;
    color: var(--text);
  }
  /* Chinese breaks only at punctuation and spaces, so no clause is cut in the middle of a word. */
  .ct p:lang(zh) {
    word-break: keep-all;
    text-wrap: wrap;
  }

  @media (max-width: 1080px) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 680px) {
    .bento {
      grid-template-columns: minmax(0, 1fr);
    }
    .card,
    .card[data-repo="omp-config"],
    .card[data-repo="omp-remote-build"] {
      grid-column: auto;
      height: auto;
      padding-bottom: 16px;
    }
    .ct {
      padding: 16px 20px 0;
    }
    .name {
      margin-top: 4px;
    }
    .ct p {
      margin-top: 6px;
    }
  }
</style>
