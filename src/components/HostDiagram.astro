---
import type { Lang } from "../i18n";
import { home } from "../copy/home";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { top, hosts } = home.hosts;
const hostTones = ["var(--agent)", "var(--human)"];
---

<div class="hd">
  <a class="hd-box hd-top" style="--tone:var(--accent)" href={top.repo}>
    <span class="hd-name">{top.name}<span class="hd-out" aria-hidden="true">↗</span></span>
    <span class="hd-role">{top.role[lang]}</span>
  </a>
  <div class="hd-links" aria-hidden="true"><span></span><span></span></div>
  <div class="hd-hosts">
    {
      hosts.map((row, i) => {
        const Box = row.repo === null ? "div" : "a";
        return (
          <Box class="hd-box" style={`--tone:${hostTones[i]}`} href={row.repo ?? undefined}>
            <span class="hd-name">
              {row.name}
              {row.repo !== null && <span class="hd-out" aria-hidden="true">↗</span>}
            </span>
            <span class="hd-role">{row.role[lang]}</span>
          </Box>
        );
      })
    }
  </div>
</div>

<style>
  .hd {
    display: grid;
  }
  .hd-box {
    display: grid;
    gap: 8px;
    align-content: start;
    padding: 20px 22px;
    border-radius: 14px;
    border: 1px solid color-mix(in srgb, var(--tone) 35%, transparent);
    background:
      linear-gradient(160deg, color-mix(in srgb, var(--tone) 12%, transparent), transparent 70%),
      var(--bg-raised);
  }
  .hd-top {
    box-shadow: 0 0 60px -20px color-mix(in srgb, var(--tone) 60%, transparent);
  }
  a.hd-box {
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s;
  }
  a.hd-box:hover {
    border-color: color-mix(in srgb, var(--tone) 70%, transparent);
  }
  .hd-out {
    margin-left: 6px;
    font-weight: 400;
    color: var(--dim);
  }
  .hd-hosts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  /* Two connectors from the top layer down into each host. */
  .hd-links {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    height: 28px;
  }
  .hd-links span {
    justify-self: center;
    width: 1px;
    background: linear-gradient(var(--accent), var(--line-strong));
  }
  .hd-name {
    font-family: var(--mono);
    font-size: 15px;
    font-weight: 600;
    color: var(--tone);
  }
  .hd-role {
    color: var(--muted);
    font-size: 14.5px;
  }
  @media (max-width: 480px) {
    .hd-hosts {
      gap: 10px;
    }
    .hd-box {
      padding: 16px 14px;
    }
    .hd-name {
      font-size: 13px;
    }
    .hd-role {
      font-size: 13.5px;
    }
  }
</style>
