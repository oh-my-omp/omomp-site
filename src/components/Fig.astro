---
import type { Lang } from "../i18n";

/**
 * Architecture drawings for the four engineering rules (FIG 0.1–0.4), drawn for a narrow column:
 * a 240×260 canvas shown at its own size on the principles page and scaled slightly down in the home grid.
 */
interface Props {
  fig: "append" | "signals" | "roles" | "policy";
  lang: Lang;
}
const { fig, lang } = Astro.props;
const zh = lang === "zh";
const L = (en: string, cn: string) => (zh ? cn : en);
const described = {
  append: L(
    "Request bytes. Rewriting the system prompt changes the prefix and the cache misses; appending a <system-reminder> or a tools delta keeps system and tools unchanged and the cache hits.",
    "请求字节流。原地改写 system prompt 会让前缀变化、缓存失效；在末尾追加 <system-reminder> 或工具差分消息时，system 与 tools 不变，缓存命中。",
  ),
  signals: L(
    "The agent loop with four hook points: tool_call blocks, tool_result appends a reminder, subagent yield and turn end are judged, and each answer goes back into the loop.",
    "代理循环上的四个挂载点：tool_call 拦下，tool_result 追加提醒，子代理交付与回合结束由判定处理，结果都送回循环。",
  ),
  roles: L(
    "Permission boundary. The main agent briefs stateless task workers in isolated worktrees; your own words reach read-only advisors directly through user-prompt-inject.",
    "权限边界。主代理给隔离 worktree 里的无状态 task 执行者派工；你的原话经 user-prompt-inject 直接送到只读顾问。",
  ),
  policy: L(
    "The extension's fixed mechanism reads policy files; on update, upstream, the common base and your copy merge three ways and your edits are kept.",
    "扩展的固定机制读取策略文件；更新时仓库新版、共同基线和你的本机副本三方合并，保留你的改动。",
  ),
}[fig];
const workers = ["wt/orders", "wt/search", "wt/webhooks"];
---

<svg class:list={["fig", { zh }]} viewBox="0 0 240 260" role="img" aria-label={described}>
  {
    fig === "append" && (
      <g>
        <text class="t" x="8" y="14">{L("system prompt rewritten", "system prompt 被原地改写")}</text>
        <rect class="b bad" x="8" y="22" width="62" height="26" rx="3" />
        <path class="hatch" d="M14 48 30 22M26 48 42 22M38 48 54 22M50 48 66 22" />
        <rect class="b" x="74" y="22" width="44" height="26" rx="3" />
        <rect class="b" x="122" y="22" width="34" height="26" rx="3" />
        <rect class="b" x="160" y="22" width="34" height="26" rx="3" />
        <rect class="b" x="198" y="22" width="34" height="26" rx="3" />
        <text class="m c" x="39" y="39">system</text>
        <text class="m c" x="96" y="39">tools</text>
        <text class="m c" x="139" y="39">msg</text>
        <text class="m c" x="177" y="39">msg</text>
        <text class="m c" x="215" y="39">msg</text>
        <path class="miss" d="M8 58H232" />
        <text class="t bad-t" x="8" y="74">{L("prefix changed · cache miss", "前缀变了，缓存失效")}</text>

        <text class="t" x="8" y="108">{L("omomp appends at the end", "omomp 在末尾追加")}</text>
        <rect class="b" x="8" y="116" width="54" height="26" rx="3" />
        <rect class="b" x="66" y="116" width="40" height="26" rx="3" />
        <rect class="b" x="110" y="116" width="28" height="26" rx="3" />
        <rect class="b" x="142" y="116" width="28" height="26" rx="3" />
        <rect class="b new" x="176" y="116" width="28" height="26" rx="3" />
        <rect class="b new" x="208" y="116" width="24" height="26" rx="3" />
        <text class="m c" x="35" y="133">system</text>
        <text class="m c" x="86" y="133">tools</text>
        <text class="m c" x="124" y="133">msg</text>
        <text class="m c" x="156" y="133">msg</text>
        <text class="m c new-t" x="190" y="133">rem</text>
        <text class="m c new-t" x="220" y="133">Δ</text>
        <path class="hit" d="M8 152H170" />
        <path class="fresh" d="M176 152H232" />
        <text class="t ok-t" x="8" y="168">{L("prefix unchanged · cache hit", "前缀不变，命中缓存")}</text>

        <rect class="b new" x="8" y="190" width="12" height="12" rx="2" />
        <text class="m" x="28" y="200">rem</text>
        <text class="m new-t" x="56" y="200">{"<system-reminder>"}</text>
        <rect class="b new" x="8" y="210" width="12" height="12" rx="2" />
        <text class="m" x="28" y="220">Δ</text>
        <text class="t new-t" x="56" y="220">{L("tools delta", "工具差分消息")}</text>
        <text class="t" x="8" y="250">{L("system and tools stay fixed", "会话中途 system 与 tools 不动")}</text>
      </g>
    )
  }
  {
    fig === "signals" && (
      <g>
        <text class="t" x="8" y="16">{L("agent loop", "代理循环")}</text>
        <path class="axis" d="M26 30V226" />
        <path class="loop" d="M26 226C26 238 10 238 10 224V40C10 26 18 26 22 30" />
        <path class="loop-head" d="M17 26 23 31 16 33" />
        {[
          { y: 48, at: "tool_call", mono: true, kind: "bad", out: L("block", "拦下") },
          { y: 100, at: "tool_result", mono: true, kind: "ok", out: L("reminder", "提醒") },
          { y: 152, at: L("subagent yield", "子代理交付"), mono: false, kind: "warn", out: L("judge", "判定") },
          { y: 204, at: L("turn end", "回合结束"), mono: false, kind: "warn", out: L("judge", "判定") },
        ].map((p) => (
          <g>
            <circle class="node" cx="26" cy={p.y} r="4" />
            <text class:list={[p.mono ? "m" : "t"]} x="38" y={p.y + 4}>
              {p.at}
            </text>
            <path class="link" d={`M134 ${p.y}H154`} />
            <rect class:list={["b", p.kind]} x="156" y={p.y - 11} width="76" height="22" rx="11" />
            <text class:list={["t", "c", `${p.kind}-t`]} x="194" y={p.y + 4}>
              {p.out}
            </text>
            <path class:list={["back", p.kind]} d={`M168 ${p.y + 11}C160 ${p.y + 28} 70 ${p.y + 26} 32 ${p.y + 26}`} />
            <path class:list={["back-head", p.kind]} d={`M37 ${p.y + 22} 32 ${p.y + 26} 37 ${p.y + 30}`} />
          </g>
        ))}
        <text class="t" x="8" y="252">{L("answered where drift shows up", "在偏离出现的那一步处理")}</text>
      </g>
    )
  }
  {
    fig === "roles" && (
      <g>
        <circle class="b" cx="22" cy="27" r="14" />
        <text class="t c" x="22" y="31">{L("you", "你")}</text>
        <path class="link solid" d="M36 27H48" />
        <rect class="b" x="48" y="10" width="184" height="34" rx="5" />
        <text class="t c strong" x="140" y="24">{L("main agent", "主代理")}</text>
        <text class="t c" x="140" y="38">{L("plans · dispatches", "编排、派发")}</text>

        <path class="link solid" d="M140 44V62" />
        <path class="head" d="M136 57 140 62 144 57" />
        <text class="t" x="146" y="56">{L("brief", "派工")}</text>
        <rect class="zone" x="48" y="64" width="184" height="94" rx="6" />
        <text class="t" x="56" y="79">{L("isolated · stateless", "隔离 worktree，无状态")}</text>
        {workers.map((w, i) => (
          <g>
            <rect class="b" x="56" y={86 + i * 23} width="168" height="18" rx="3" />
            <text class="m c" x="140" y={99 + i * 23}>{`task:low  ${w}`}</text>
          </g>
        ))}

        <path class="link" d="M232 27H238V202H232" />
        <rect class="b ro" x="48" y="180" width="184" height="44" rx="5" />
        <text class="m c" x="140" y="198">discuss:* · mentor:default</text>
        <text class="t c ok-t" x="140" y="215">{L("read-only · no tools", "只读或无工具")}</text>

        <path class="inject" d="M22 41V202H44" />
        <path class="inject-head" d="M40 198 46 202 40 206" />
        <text class="t new-t" x="8" y="246">{L("your own words,", "你的原话，")}</text>
        <text class="m new-t" x={zh ? "68" : "110"} y="246">user-prompt-inject</text>
      </g>
    )
  }
  {
    fig === "policy" && (
      <g>
        <rect class="b mech" x="8" y="8" width="224" height="50" rx="5" />
        <text class="t strong" x="16" y="24">{L("extension: fixed mechanism", "扩展：固定机制")}</text>
        <text class="m" x="16" y="39">{L("when  target · mode · model", "条件  target · mode · model")}</text>
        <text class="m" x="16" y="52">{L("then  append · replace · judge", "动作  追加 · 替换 · 判定")}</text>
        <path class="link" d="M120 58V72" />
        <text class="t" x="126" y="69">{L("reads", "读取")}</text>
        <text class="t" x="8" y="86">{L("policy files: examples you own", "策略文件：可替换的示例")}</text>
        {[
          { x: 8, name: L("upstream", "仓库新版"), upstream: true, yours: false },
          { x: 84, name: L("base", "共同基线"), upstream: false, yours: false },
          { x: 160, name: L("yours", "你的本机"), upstream: false, yours: true },
        ].map((f) => (
          <g>
            <rect class="b" x={f.x} y="94" width="72" height="44" rx="4" />
            <path class="row" d={`M${f.x + 9} 105H${f.x + 58}M${f.x + 9} 116H${f.x + 50}M${f.x + 9} 127H${f.x + 62}`} />
            {f.upstream && <path class="up" d={`M${f.x + 9} 127H${f.x + 62}`} />}
            {f.yours && <path class="mark" d={`M${f.x + 9} 116H${f.x + 50}`} />}
            <text class="t c" x={f.x + 36} y="153">{f.name}</text>
          </g>
        ))}
        <path class="link" d="M44 158C44 172 100 168 112 178M120 158V172M196 158C196 172 140 168 128 178" />
        <rect class="b merge" x="113" y="174" width="14" height="14" rx="2" transform="rotate(45 120 181)" />
        <text class="t" x="134" y="185">{L("three-way merge", "三方合并")}</text>
        <path class="link solid" d="M120 192V202" />
        <rect class="b" x="84" y="202" width="72" height="36" rx="4" />
        <path class="row" d={`M93 213H142M93 224H134`} />
        <path class="mark" d="M93 224H134" />
        <path class="up" d="M93 213H142" />
        <path class="mark" d="M8 254H20" />
        <text class="t" x="26" y="257">{L("your edits kept", "保留你的改动")}</text>
        <path class="up" d="M132 254H144" />
        <text class="t" x="150" y="257">{L("upstream in", "合入仓库更新")}</text>
      </g>
    )
  }
</svg>

<style>
  .fig {
    width: 100%;
    max-width: 250px;
    height: auto;
    display: block;
    margin-inline: auto;
    overflow: visible;
  }
  .b {
    fill: rgb(255 255 255 / 0.025);
    stroke: rgb(255 255 255 / 0.22);
    stroke-width: 1;
  }
  .b.bad {
    stroke: color-mix(in srgb, var(--danger) 70%, transparent);
    fill: color-mix(in srgb, var(--danger) 6%, transparent);
  }
  .b.ok,
  .b.ro {
    stroke: color-mix(in srgb, var(--silent) 60%, transparent);
  }
  .b.warn {
    stroke: color-mix(in srgb, var(--warn) 60%, transparent);
  }
  .b.new,
  .b.merge {
    stroke: var(--accent);
    fill: var(--accent-soft);
  }
  .b.mech {
    stroke: rgb(255 255 255 / 0.35);
  }
  .hatch {
    stroke: color-mix(in srgb, var(--danger) 40%, transparent);
    stroke-width: 1;
  }
  /* Prose labels in the page's face, code names in mono. */
  .t {
    font-family: var(--mono);
    font-size: 10.5px;
    fill: var(--muted);
  }
  .zh .t {
    font-family: var(--sans);
    font-size: 11.5px;
  }
  .m {
    font-family: var(--mono);
    font-size: 10px;
    fill: var(--soft);
  }
  .c {
    text-anchor: middle;
  }
  .strong {
    fill: var(--text);
  }
  .bad-t {
    fill: var(--danger);
  }
  .ok-t {
    fill: var(--silent);
  }
  .warn-t {
    fill: var(--warn);
  }
  .new-t {
    fill: var(--accent);
  }
  .miss {
    stroke: var(--danger);
    stroke-dasharray: 4 3;
  }
  .hit {
    stroke: var(--silent);
    stroke-width: 2;
  }
  .fresh {
    stroke: var(--accent);
    stroke-width: 2;
  }
  .axis {
    stroke: rgb(255 255 255 / 0.35);
    fill: none;
  }
  .loop,
  .loop-head {
    stroke: rgb(255 255 255 / 0.3);
    fill: none;
  }
  .node {
    fill: var(--bg);
    stroke: var(--text);
  }
  .link {
    stroke: rgb(255 255 255 / 0.28);
    fill: none;
    stroke-dasharray: 3 3;
  }
  .link.solid {
    stroke-dasharray: none;
  }
  .head {
    stroke: rgb(255 255 255 / 0.28);
    fill: none;
  }
  .back,
  .back-head {
    fill: none;
    stroke-width: 1.1;
  }
  .back.bad,
  .back-head.bad {
    stroke: var(--danger);
  }
  .back.ok,
  .back-head.ok {
    stroke: var(--silent);
  }
  .back.warn,
  .back-head.warn {
    stroke: var(--warn);
  }
  .zone {
    fill: none;
    stroke: rgb(255 255 255 / 0.18);
    stroke-dasharray: 2 3;
  }
  .inject,
  .inject-head {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.2;
  }
  .inject {
    stroke-dasharray: 5 3;
  }
  .row {
    stroke: rgb(255 255 255 / 0.18);
    stroke-width: 2;
    stroke-linecap: round;
  }
  .mark {
    stroke: var(--accent);
    stroke-width: 2;
    stroke-linecap: round;
  }
  .up {
    stroke: var(--silent);
    stroke-width: 2;
    stroke-linecap: round;
  }
</style>
