---
interface Link {
  href: string;
  label: string;
  title: string;
}
interface Props {
  prev: Link;
  next: Link;
}
const { prev, next } = Astro.props;
/** A link that leaves the site gets the outward arrow, so it is not mistaken for the next page. */
const arrow = (l: Link) => (/^https?:\/\//.test(l.href) ? "↗" : "→");
---

<nav class="pager" aria-label="Pagination">
  <div class="wrap row">
    <a class="p prev" href={prev.href}>
      <span class="k">← {prev.label}</span>
      <span class="t">{prev.title}</span>
    </a>
    <a class="p next" href={next.href}>
      <span class="k">{next.label} {arrow(next)}</span>
      <span class="t">{next.title}</span>
    </a>
  </div>
</nav>

<style>
  .pager {
    border-top: 1px solid var(--line);
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .p {
    display: grid;
    gap: 4px;
    padding-block: 40px;
    color: var(--muted);
    transition: color 0.15s;
  }
  .p:hover {
    color: var(--text);
  }
  .prev {
    padding-right: 24px;
  }
  .next {
    text-align: right;
    padding-left: 24px;
    border-left: 1px solid var(--line);
  }
  .k {
    font-size: 13px;
    color: var(--dim);
  }
  .t {
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  @media (max-width: 640px) {
    .row {
      grid-template-columns: 1fr;
    }
    .next {
      text-align: left;
      padding-left: 0;
      border-left: 0;
      border-top: 1px solid var(--line);
    }
  }
</style>
