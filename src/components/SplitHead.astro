---
import { inlineCode, wholeNames } from "../i18n";
interface Props {
  title: string;
  lede?: string;
  id?: string;
  /** Small grey line above the title, for a section that belongs to a named group. */
  kicker?: string;
  /** 1 when the split head opens the page and its title is the page's h1. */
  level?: 1 | 2;
  /** Keep hyphenated names in the lede on one line instead of rendering `backtick` spans as code. */
  names?: "whole";
}
const { title, lede, id, kicker, level = 2, names } = Astro.props;
const Heading = level === 1 ? "h1" : "h2";
// Without a right column the heading takes the width the lede would have shared, instead of wrapping beside an empty half.
const solo = !lede && !Astro.slots.has("default");
---

<header class="split wrap" id={id}>
  <div class:list={["l", { solo }]}>
    {kicker && <p class="kicker">{kicker}</p>}
    <Heading>{title}</Heading>
  </div>
  {
    !solo && (
      <div class="r">
        {lede && <p class="lede" set:html={names === "whole" ? wholeNames(lede) : inlineCode(lede)} />}
        <slot />
      </div>
    )
  }
</header>

<style>
  .split {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 24px;
    row-gap: 20px;
    align-items: start;
  }
  .l {
    grid-column: 1 / span 5;
    display: grid;
    gap: 14px;
  }
  .l.solo {
    grid-column: 1 / span 9;
  }
  .r {
    grid-column: 7 / span 6;
    display: grid;
    gap: 22px;
    justify-items: start;
    padding-top: 6px;
  }
  .lede {
    font-size: clamp(17px, 1.6vw, 21px);
    line-height: 1.5;
    color: var(--soft);
    letter-spacing: -0.01em;
  }
  @media (max-width: 860px) {
    .l,
    .l.solo,
    .r {
      grid-column: 1 / -1;
    }
    .r {
      padding-top: 0;
    }
  }
</style>
