---
import { inlineCode } from "../i18n";
interface Props {
  title: string;
  lede?: string;
  id?: string;
  /** Small grey line above the title, for a section that belongs to a named group. */
  kicker?: string;
}
const { title, lede, id, kicker } = Astro.props;
---

<header class="split wrap" id={id}>
  <div class="l">
    {kicker && <p class="kicker">{kicker}</p>}
    <h2>{title}</h2>
  </div>
  <div class="r">
    {lede && <p class="lede" set:html={inlineCode(lede)} />}
    <slot />
  </div>
</header>

<style>
  .split {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 24px;
    row-gap: 20px;
    align-items: start;
  }
  .l {
    grid-column: 1 / span 5;
    display: grid;
    gap: 14px;
  }
  .r {
    grid-column: 7 / span 6;
    display: grid;
    gap: 22px;
    justify-items: start;
    padding-top: 6px;
  }
  .lede {
    font-size: clamp(17px, 1.6vw, 21px);
    line-height: 1.5;
    color: var(--soft);
    letter-spacing: -0.01em;
  }
  @media (max-width: 860px) {
    .l,
    .r {
      grid-column: 1 / -1;
    }
    .r {
      padding-top: 0;
    }
  }
</style>
