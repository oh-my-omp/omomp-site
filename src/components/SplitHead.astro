---
import { inlineCode, wholeNames } from "../i18n";
interface Props {
  title: string;
  lede?: string;
  id?: string;
  kicker?: string;
  kickerName?: string;
  level?: 1 | 2;
  names?: "whole";
  editorial?: boolean;
}
const { title, lede, id, kicker, kickerName, level = 2, names, editorial = false } = Astro.props;
const Heading = level === 1 ? "h1" : "h2";
const solo = !lede && !Astro.slots.has("default");
---

<header class="split wrap" id={id}>
  <div class:list={["l", { solo }]}>
    {
      kicker && (
        <p class="kicker">
          {kicker}
          {kickerName && (
            <>
              {" · "}
              <span class="kicker-name">{kickerName}</span>
            </>
          )}
        </p>
      )
    }
    <Heading class:list={[{ editorial }]}>{title}</Heading>
  </div>
  {
    !solo && (
      <div class="r">
        {lede && <p class="lede" set:html={names === "whole" ? wholeNames(lede) : inlineCode(lede)} />}
        <slot />
      </div>
    )
  }
</header>

<style>
  .split {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 24px;
    row-gap: 20px;
    align-items: start;
  }
  .l {
    grid-column: 1 / span 5;
    display: grid;
    gap: 14px;
  }
  .l.solo {
    grid-column: 1 / span 9;
  }
  .r {
    grid-column: 7 / span 6;
    display: grid;
    gap: 22px;
    justify-items: start;
    padding-top: 6px;
  }
  .lede {
    font-size: clamp(17px, 1.6vw, 21px);
    line-height: 1.5;
    color: var(--soft);
    letter-spacing: -0.01em;
  }
  @media (max-width: 860px) {
    .l,
    .l.solo,
    .r {
      grid-column: 1 / -1;
    }
    .r {
      padding-top: 0;
    }
  }
</style>
