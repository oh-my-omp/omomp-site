---
interface Props {
  /** Tabs across the top bar; the first one is drawn as selected unless `active` says otherwise. */
  tabs?: readonly string[];
  active?: number;
  /** Right side of the top bar: a session id, a status, a path. */
  meta?: string;
  class?: string;
}
const { tabs = [], active = 0, meta, class: extra } = Astro.props;
---

<div class:list={["win", extra]}>
  {
    (tabs.length > 0 || meta) && (
      <div class="bar">
        <div class="tabs">
          {tabs.map((tab, i) => (
            <span class:list={[{ on: i === active }]}>{tab}</span>
          ))}
        </div>
        {meta && <span class="meta">{meta}</span>}
      </div>
    )
  }
  <div class="body"><slot /></div>
</div>

<style>
  .win {
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    background: var(--bg-panel);
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.4),
      0 24px 60px -24px rgb(0 0 0 / 0.8);
    overflow: hidden;
    min-width: 0;
    text-align: left;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 12px;
    height: 38px;
    border-bottom: 1px solid var(--line);
    font-size: 12.5px;
  }
  .tabs {
    display: flex;
    gap: 2px;
    min-width: 0;
    overflow: hidden;
  }
  .tabs span {
    padding: 3px 9px;
    border-radius: 6px;
    color: var(--muted);
    white-space: nowrap;
  }
  .tabs span.on {
    color: var(--text);
    background: rgb(255 255 255 / 0.06);
  }
  .meta {
    margin-left: auto;
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--dim);
    white-space: nowrap;
  }
  .body {
    min-width: 0;
  }
</style>
