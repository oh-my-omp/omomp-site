---
import { inlineCode } from "../i18n";
interface Props {
  kicker: string;
  title: string;
  lede?: string;
}
const { kicker, title, lede } = Astro.props;
---

<header class="ph wrap">
  <p class="kicker">{kicker}</p>
  <h1>{title}</h1>
  {lede && <p class="lede" set:html={inlineCode(lede)} />}
  <slot />
</header>

<style>
  .ph {
    padding-top: clamp(72px, 11vw, 140px);
    padding-bottom: clamp(56px, 8vw, 96px);
    display: grid;
    gap: 20px;
    justify-items: start;
  }
  h1 {
    max-width: 15em;
  }
  .lede {
    font-size: clamp(17px, 1.5vw, 19px);
    color: var(--muted);
    max-width: 38em;
  }
</style>
