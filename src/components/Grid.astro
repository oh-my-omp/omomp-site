---
interface Props {
  cols?: 1 | 2 | 3 | 4;
  /** Number of cells inside, so the last row is closed with blank cells instead of showing the line colour. */
  count?: number;
}
const { cols = 3, count } = Astro.props;
const blanks = count === undefined ? 0 : (cols - (count % cols)) % cols;
---

<div class:list={["grid", { multi: cols > 1 }]} style={`--cols:${cols}`}>
  <slot />
  {Array.from({ length: blanks }, () => <div class="blank" aria-hidden="true" />)}
</div>

<style>
  /* The cells sit on the line colour with a 1px gap, so every inner divider is one hairline. */
  .grid {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
  }
  .blank {
    grid-row: span 2;
    background: var(--bg);
  }
  @media (max-width: 960px) {
    .grid {
      grid-template-columns: repeat(min(var(--cols), 2), minmax(0, 1fr));
    }
  }
  @media (min-width: 641px) and (max-width: 960px) {
    .multi > :global(:last-child:nth-child(odd)) {
      grid-column: span 2;
    }
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .blank {
      display: none;
    }
  }
</style>
