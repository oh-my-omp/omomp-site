---
import { preview } from "../copy/preview";
import { href, t, wholeNames, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<section class="hero wrap">
  <h1>
    <span>{t(preview.hero.title[0], lang)}</span>
    <span class="second">{t(preview.hero.title[1], lang)}</span>
  </h1>
  <p class="lede">
    <span set:html={wholeNames(t(preview.hero.lede[0], lang))} />{" "}
    <span set:html={wholeNames(t(preview.hero.lede[1], lang))} />
  </p>
  <div class="ctas">
    <a class="btn btn-primary" href={href("/replay/", lang)}>{t(preview.hero.primary, lang)}</a>
    <a class="btn" href={href("/lifeline/", lang)}>{t(preview.hero.secondary, lang)}</a>
  </div>
</section>

<style>
  /* First screen as supabase.com: heading and buttons on the left, a plain lede on the right that starts on the
     left edge of the second card below (the card grid has the same two halves and the same 12px gap). On a phone
     the lede comes before the buttons, so the reader knows what the product is before being asked to act. */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-areas:
      "h lede"
      "cta lede";
    gap: 26px 12px;
    align-items: start;
    padding-top: clamp(40px, 7vw, 100px);
    padding-bottom: clamp(32px, 3.5vw, 44px);
  }
  h1 {
    grid-area: h;
    display: grid;
    font-size: clamp(33px, 4vw, 52px);
    font-weight: 500;
    line-height: 1.08;
  }
  .second {
    color: var(--accent);
  }
  .lede {
    grid-area: lede;
    margin-top: 6px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--muted);
    max-width: 36em;
  }
  .lede span {
    display: block;
  }
  /* Chinese breaks only at punctuation and spaces, so no clause is cut in the middle of a word. */
  .lede:lang(zh) {
    word-break: keep-all;
  }
  .ctas {
    grid-area: cta;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  @media (max-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "h"
        "lede"
        "cta";
      gap: 18px;
    }
    .lede {
      margin-top: 0;
    }
    .lede span {
      display: inline;
    }
  }
</style>
