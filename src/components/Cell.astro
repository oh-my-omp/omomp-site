---
import { inlineCode } from "../i18n";
interface Props {
  title: string;
  text: string;
  /** Small line above the title, such as a component name or a figure number. */
  tag?: string;
  href?: string;
  /** Title is a code name (a plugin, tool or extension) and is set in the monospace face. */
  mono?: boolean;
}
const { title, text, tag, href, mono } = Astro.props;
const Tag = href ? "a" : "div";
const hasArt = Astro.slots.has("default");
---

<Tag class:list={["cell", { link: href, bare: !hasArt }]} href={href}>
  {hasArt && <div class="art"><slot /></div>}
  <div class="txt">
    {tag && <span class="tag" set:html={inlineCode(tag)} />}
    <h3 class:list={{ mono }}>{title}</h3>
    <p set:html={inlineCode(text)} />
  </div>
</Tag>

<style>
  .cell {
    display: grid;
    grid-template-rows: minmax(240px, 1fr) auto;
    background: var(--bg);
    min-width: 0;
  }
  .bare {
    grid-template-rows: auto;
  }
  .link {
    transition: background 0.15s;
  }
  .link:hover {
    background: #0c0d0e;
  }
  .art {
    display: grid;
    place-items: center;
    padding: 32px 28px 8px;
    min-width: 0;
    overflow: hidden;
  }
  .txt {
    display: grid;
    gap: 6px;
    padding: 20px 28px 30px;
  }
  .tag {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--dim);
  }
  .tag :global(code) {
    padding: 0;
    border: 0;
    background: none;
    font-size: inherit;
  }
  h3.mono {
    font-family: var(--mono);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0;
  }
  p {
    color: var(--muted);
    font-size: 15px;
    max-width: 30em;
  }
</style>
