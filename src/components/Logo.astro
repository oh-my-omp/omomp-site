---
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---

<svg
  width={size * 1.5}
  height={size}
  viewBox="0 0 48 32"
  fill="none"
  stroke="var(--accent)"
  stroke-width="4"
  stroke-linecap="round"
  stroke-linejoin="round"
  role="img"
  aria-label="oh-my-omp"
>
  <path d="M4 8 12 16 4 24" />
  <path d="M18 9h26" />
  <path d="M25 9c0 7-1.4 12-5 16" />
  <path d="M36 9v11.5c0 3 1.3 4.5 4 4.5h3" />
</svg>
