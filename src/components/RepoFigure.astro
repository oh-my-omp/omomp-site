---
import type { Figure } from "../data/repos";
import type { Lang } from "../i18n";

interface Props {
  figure: Figure;
  lang: Lang;
}
const { figure, lang } = Astro.props;
const zh = lang === "zh";
const seamNodes = [0, 1, 2, 3, 4, 5];
---

<svg class="fig" viewBox="0 0 320 88" role="presentation" aria-hidden="true">
  {
    figure === "seams" && (
      <g>
        <line x1="24" y1="40" x2="296" y2="40" class="track" />
        {seamNodes.map((i) => (
          <g transform={`translate(${24 + i * 54.4} 40)`}>
            <circle r="11" class="node" />
            <circle r="3.5" class="live" />
            <text y="30" class="lbl" text-anchor="middle">
              {String(i + 1).padStart(2, "0")}
            </text>
          </g>
        ))}
      </g>
    )
  }
  {
    figure === "playbooks" && (
      <g>
        <rect x="16" y="10" width="112" height="68" rx="8" class="box" />
        <text x="28" y="28" class="lbl">Playbook</text>
        <rect x="28" y="38" width="88" height="8" rx="3" class="bar" />
        <rect x="28" y="52" width="72" height="8" rx="3" class="bar" />
        <rect x="28" y="64" width="80" height="6" rx="3" class="bar" />
        <path d="M136 44 h40" class="arrow" />
        <path d="M170 39 l6 5 -6 5" class="arrow" />
        <rect x="188" y="10" width="116" height="68" rx="8" class="box hot" />
        <text x="200" y="28" class="lbl">Run</text>
        <circle cx="204" cy="42" r="4" class="done" />
        <rect x="214" y="38" width="76" height="8" rx="3" class="bar" />
        <circle cx="204" cy="56" r="4" class="done" />
        <rect x="214" y="52" width="60" height="8" rx="3" class="bar" />
        <circle cx="204" cy="68" r="4" class="live" />
        <rect x="214" y="65" width="68" height="6" rx="3" class="bar" />
      </g>
    )
  }
  {
    figure === "dispatch" && (
      <g>
        <text x="16" y="16" class="lbl">issue</text>
        <circle cx="44" cy="34" r="6" class="node" />
        <path d="M44 40 v8 M24 48 h40 M24 48 v8 M44 48 v8 M64 48 v8" class="track" />
        <circle cx="24" cy="62" r="5" class="node" />
        <circle cx="44" cy="62" r="5" class="node live-stroke" />
        <circle cx="64" cy="62" r="5" class="node" />
        <path d="M84 62 h28" class="arrow" />
        <path d="M106 57 l6 5 -6 5" class="arrow" />
        <rect x="120" y="46" width="76" height="32" rx="8" class="box" />
        <text x="158" y="66" class="lbl" text-anchor="middle">{zh ? "负责人" : "owner"}</text>
        <path d="M200 62 h24" class="arrow" />
        <path d="M218 57 l6 5 -6 5" class="arrow" />
        <rect x="228" y="46" width="76" height="32" rx="8" class="box hot" />
        <text x="266" y="66" class="lbl" text-anchor="middle">{zh ? "审查者" : "reviewer"}</text>
        <path d="M266 42 v-14 h-108 v14" class="arrow dim" />
        <path d="M153 36 l5 6 5 -6" class="arrow dim" />
      </g>
    )
  }
  {
    figure === "remote-build" && (
      <g>
        <rect x="16" y="10" width="112" height="68" rx="8" class="box" />
        <text x="28" y="28" class="lbl">{zh ? "本机" : "laptop"}</text>
        <rect x="28" y="38" width="88" height="14" rx="4" class="bar" />
        <text x="34" y="48" class="tiny">worktree a</text>
        <rect x="28" y="58" width="88" height="14" rx="4" class="bar" />
        <text x="34" y="68" class="tiny">worktree b</text>
        <path d="M128 45 h56" class="arrow" />
        <path d="M178 40 l6 5 -6 5" class="arrow" />
        <path d="M128 65 h56" class="arrow" />
        <path d="M178 60 l6 5 -6 5" class="arrow" />
        <rect x="192" y="10" width="112" height="68" rx="8" class="box hot" />
        <text x="204" y="28" class="lbl">{zh ? "构建机" : "build host"}</text>
        <rect x="204" y="38" width="88" height="14" rx="4" class="bar ctr" />
        <text x="210" y="48" class="tiny">{zh ? "容器 a" : "container a"}</text>
        <rect x="204" y="58" width="88" height="14" rx="4" class="bar ctr" />
        <text x="210" y="68" class="tiny">{zh ? "容器 b" : "container b"}</text>
      </g>
    )
  }
</svg>

<style>
  .fig {
    display: block;
    width: 100%;
    max-width: 340px;
    height: auto;
    margin-block: 4px;
  }
  .track {
    stroke: var(--line-strong);
    stroke-width: 1.5;
    fill: none;
  }
  .node {
    fill: var(--bg-sunken);
    stroke: var(--line-strong);
    stroke-width: 1.5;
  }
  .live-stroke {
    stroke: var(--accent);
  }
  .box {
    fill: var(--bg-sunken);
    stroke: var(--line-strong);
  }
  .box.hot {
    stroke: rgb(247 168 35 / 0.45);
  }
  .bar {
    fill: rgb(255 255 255 / 0.07);
  }
  .bar.ctr {
    fill: rgb(247 168 35 / 0.1);
  }
  .arrow {
    stroke: var(--accent);
    stroke-width: 1.5;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .arrow.dim {
    stroke: var(--dim);
    stroke-dasharray: 3 3;
  }
  .done {
    fill: var(--silent);
  }
  .live {
    fill: var(--accent);
  }
  .lbl {
    font-family: var(--mono);
    font-size: 11px;
    fill: var(--muted);
  }
  .tiny {
    font-family: var(--mono);
    font-size: 9px;
    fill: var(--dim);
  }
</style>
