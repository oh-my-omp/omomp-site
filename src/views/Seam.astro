---
import { getCollection, type CollectionEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import SplitHead from "../components/SplitHead.astro";
import Grid from "../components/Grid.astro";
import Cell from "../components/Cell.astro";
import Pager from "../components/Pager.astro";
import ReplayPlayer from "../islands/ReplayPlayer";
import SeamStage from "../components/SeamStage.astro";
import ArtView from "../slices/Art";
import { seamPage as copy, replayPage } from "../copy/pages";
import { componentArt, type ComponentId } from "../data/component-art";
import { playerLabels, scenario } from "../data/scenario";
import { parseSeamId, seamStage } from "../data/seam-stages";
import { href, t, type Lang } from "../i18n";
import { ui } from "../ui";

interface Props {
  lang: Lang;
  seam: CollectionEntry<"seams">;
}
const { lang, seam } = Astro.props;
const seamId = parseSeamId(seam.id);
const seams = (await getCollection("seams")).sort((a, b) => a.data.order - b.data.order);
const index = seams.findIndex((s) => s.id === seam.id);
const prev = seams[index - 1];
const next = seams[index + 1];
const components = (await getCollection("components")).filter((c) => c.data.seam === seam.id);
const layers = ["human", "agent", "silent"] as const;
const sides = { screen: t(copy.screen, lang), model: t(copy.model, lang) };
const isComponent = (id: string): id is ComponentId => id in componentArt;
const artOf = (id: string) => {
  if (!isComponent(id)) throw new Error(`component \`${id}\` has no art in component-art.ts`);
  return componentArt[id][lang];
};
const all = scenario[lang];
const first = all.findIndex((s) => s.seam === seam.id);
const steps = all.filter((s) => s.seam === seam.id);
if (first < 0) throw new Error(`seam \`${seam.id}\` has no step in the demo scenario`);
/** The player opens on the seam's first step that puts something in front of the model, so both panes start filled. */
const opening = Math.max(0, steps.findIndex((s) => s.hooks.length > 0));
const colsFor = (n: number) => (n === 2 || n === 4 ? 2 : 3);
---

<Base lang={lang} title={seam.data.name[lang]} description={seam.data.claim[lang]}>
  <PageHead kicker={seam.data.name[lang]} title={seam.data.claim[lang]} lede={seam.data.drift[lang]}>
    <nav class="seams" aria-label={t(copy.seams, lang)}>
      {
        seams.map((s) => (
          <a
            href={href(`/lifeline/${s.id}/`, lang)}
            class:list={{ on: s.id === seam.id, past: s.data.order < seam.data.order }}
            aria-current={s.id === seam.id ? "page" : undefined}
          >
            {s.data.short[lang]}
          </a>
        ))
      }
    </nav>
  </PageHead>

  <section class="section">
    <SplitHead
      kicker={t(copy.demoKicker, lang)}
      title={lang === "en" ? `${seam.data.short.en} in the rate-limit demo` : `限流演示中的${seam.data.short.zh}`}
      lede={t(copy.demoLede, lang)}
    >
      <a class="more" href={href("/replay/", lang)}>{t(copy.demoAll, lang)} →</a>
    </SplitHead>
    <div class="wrap demo">
      <ReplayPlayer client:load lang={lang} steps={steps} labels={playerLabels[lang]} firstNumber={first + 1} total={all.length} start={opening} />
    </div>
  </section>

  {
    layers.map((l) => {
      const cells = components.filter((c) => c.data.layer === l);
      const only = cells.length === 1 ? cells[0] : undefined;
      const section = seam.data.sections[l];
      return (
        <section class="section">
          <SplitHead kicker={t(ui.layers[l], lang)} title={section.title[lang]} lede={section.lede[lang]}>
            <nav class="caps" aria-label={t(copy.components, lang)}>
              {cells.map((c) => (
                <a class={`layer-${l}`} href={`#${c.id}`}>
                  <span class="layer-dot" />
                  {c.data.name}
                </a>
              ))}
            </nav>
          </SplitHead>
          <div class="wrap layer-stage">
            <SeamStage
              lang={lang}
              stage={seamStage(seamId, l, lang)}
              sides={sides}
              only={only && { id: only.id, title: only.data.name, text: only.data.line[lang] }}
            />
          </div>
          {!only && (
            <div class="wrap cells">
              <Grid cols={colsFor(cells.length)} count={cells.length}>
                {cells.map((c) => (
                  <Cell id={c.id} title={c.data.name} text={c.data.line[lang]} href={c.data.repo} mono>
                    <ArtView lang={lang} art={artOf(c.id)} />
                  </Cell>
                ))}
              </Grid>
            </div>
          )}
        </section>
      );
    })
  }

  <Pager
    prev={prev
      ? { href: href(`/lifeline/${prev.id}/`, lang), label: t(ui.previous, lang), title: prev.data.name[lang] }
      : { href: href("/lifeline/", lang), label: t(ui.previous, lang), title: t(copy.lifeline, lang) }}
    next={next
      ? { href: href(`/lifeline/${next.id}/`, lang), label: t(ui.next, lang), title: next.data.name[lang] }
      : { href: href("/replay/", lang), label: t(ui.next, lang), title: t(replayPage.kicker, lang) }}
  />
</Base>

<style>
  .seams {
    display: flex;
    flex-wrap: wrap;
    gap: 1px;
    margin-top: 12px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .seams a {
    flex: 1 1 0;
    min-width: max-content;
    display: flex;
    gap: 10px;
    align-items: baseline;
    padding: 10px 16px;
    background: var(--bg);
    color: var(--dim);
    font-size: 14px;
    text-decoration: none;
    transition: color 0.15s;
  }
  .seams a:hover {
    color: var(--text);
  }
  .seams a.past {
    color: var(--muted);
  }
  .seams a.on {
    color: var(--text);
    background: var(--bg-raised);
    box-shadow: inset 0 -2px 0 var(--accent);
  }
  .demo,
  .layer-stage {
    margin-top: clamp(40px, 5vw, 64px);
  }
  .cells {
    margin-top: clamp(24px, 3vw, 40px);
  }
  .caps {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .caps a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 5px 11px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--soft);
    text-decoration: none;
    transition:
      color 0.15s,
      border-color 0.15s;
  }
  .caps a:hover {
    color: var(--text);
    border-color: var(--line-strong, rgb(255 255 255 / 0.18));
  }
  @media (max-width: 640px) {
    .seams a {
      flex-basis: calc(50% - 1px);
      padding: 9px 12px;
    }
  }
</style>
