---
import { getCollection, type CollectionEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import SplitHead from "../components/SplitHead.astro";
import Grid from "../components/Grid.astro";
import Cell from "../components/Cell.astro";
import Pager from "../components/Pager.astro";
import ReplayPlayer from "../islands/ReplayPlayer";
import ArtView from "../slices/Art";
import { seamPage as copy, replayPage } from "../copy/pages";
import { componentArt, type ComponentId } from "../data/component-art";
import { playerLabels, scenario } from "../data/scenario";
import { href, t, type Lang } from "../i18n";
import { ui } from "../ui";

interface Props {
  lang: Lang;
  seam: CollectionEntry<"seams">;
}
const { lang, seam } = Astro.props;
const seams = (await getCollection("seams")).sort((a, b) => a.data.order - b.data.order);
const index = seams.findIndex((s) => s.id === seam.id);
const prev = seams[index - 1];
const next = seams[index + 1];
const components = (await getCollection("components")).filter((c) => c.data.seam === seam.id);
const layers = ["human", "agent", "silent"] as const;
const pad = (n: number) => String(n).padStart(2, "0");
const isComponent = (id: string): id is ComponentId => id in componentArt;
const artOf = (id: string) => {
  if (!isComponent(id)) throw new Error(`component \`${id}\` has no art in component-art.ts`);
  return componentArt[id][lang];
};
const all = scenario[lang];
const first = all.findIndex((s) => s.seam === seam.id);
const steps = all.filter((s) => s.seam === seam.id);
if (first < 0) throw new Error(`seam \`${seam.id}\` has no step in the demo scenario`);
const colsFor = (n: number) => (n === 1 ? 1 : n === 2 || n === 4 ? 2 : 3);
---

<Base lang={lang} title={seam.data.name[lang]} description={seam.data.claim[lang]}>
  <PageHead kicker={`${t(copy.kicker, lang)} ${pad(seam.data.order)} · ${seam.data.name[lang]}`} title={seam.data.claim[lang]} lede={seam.data.drift[lang]}>
    <nav class="seams" aria-label={t(copy.seams, lang)}>
      {
        seams.map((s) => (
          <a
            href={href(`/lifeline/${s.id}/`, lang)}
            class:list={{ on: s.id === seam.id, past: s.data.order < seam.data.order }}
            aria-current={s.id === seam.id ? "page" : undefined}
          >
            <span class="n">{pad(s.data.order)}</span>
            {s.data.short[lang]}
          </a>
        ))
      }
    </nav>
  </PageHead>

  <section class="section">
    <SplitHead
      kicker={t(copy.demoKicker, lang)}
      title={lang === "en" ? `${seam.data.short.en} in the rate-limit demo` : `限流演示中的${seam.data.short.zh}`}
      lede={t(copy.demoLede, lang)}
    >
      <a class="more" href={href("/replay/", lang)}>{t(copy.demoAll, lang)} →</a>
    </SplitHead>
    <div class="wrap demo">
      <ReplayPlayer client:visible lang={lang} steps={steps} labels={playerLabels[lang]} firstNumber={first + 1} total={all.length} />
    </div>
  </section>

  {
    layers.map((l) => {
      const cells = components.filter((c) => c.data.layer === l);
      const cols = colsFor(cells.length);
      return (
        <section class="section">
          <SplitHead kicker={t(ui.layers[l], lang)} title={seam.data.sections[l][lang]} />
          <div class="wrap cells">
            <Grid cols={cols} count={cells.length}>
              {cells.map((c) => (
                <Cell title={c.data.name} text={c.data.line[lang]} href={c.data.repo} mono wide={cols === 1}>
                  <ArtView lang={lang} art={artOf(c.id)} />
                </Cell>
              ))}
            </Grid>
          </div>
        </section>
      );
    })
  }

  <Pager
    prev={prev
      ? { href: href(`/lifeline/${prev.id}/`, lang), label: `${t(ui.previous, lang)} · ${pad(prev.data.order)}`, title: prev.data.name[lang] }
      : { href: href("/lifeline/", lang), label: t(ui.previous, lang), title: t(copy.lifeline, lang) }}
    next={next
      ? { href: href(`/lifeline/${next.id}/`, lang), label: `${t(ui.next, lang)} · ${pad(next.data.order)}`, title: next.data.name[lang] }
      : { href: href("/replay/", lang), label: t(ui.next, lang), title: t(replayPage.kicker, lang) }}
  />
</Base>

<style>
  .seams {
    display: flex;
    flex-wrap: wrap;
    gap: 1px;
    margin-top: 12px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .seams a {
    flex: 1 1 0;
    min-width: max-content;
    display: flex;
    gap: 10px;
    align-items: baseline;
    padding: 10px 16px;
    background: var(--bg);
    color: var(--dim);
    font-size: 14px;
    text-decoration: none;
    transition: color 0.15s;
  }
  .seams a:hover {
    color: var(--text);
  }
  .seams a.past {
    color: var(--muted);
  }
  .seams a.on {
    color: var(--text);
    background: var(--bg-raised);
    box-shadow: inset 0 -2px 0 var(--accent);
  }
  .n {
    font-family: var(--mono);
    font-size: 12px;
  }
  .demo,
  .cells {
    margin-top: clamp(40px, 5vw, 64px);
  }
  @media (max-width: 640px) {
    .seams a {
      flex-basis: calc(50% - 1px);
      padding: 9px 12px;
    }
  }
</style>
