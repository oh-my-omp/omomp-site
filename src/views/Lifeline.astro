---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import SplitHead from "../components/SplitHead.astro";
import Grid from "../components/Grid.astro";
import Cell from "../components/Cell.astro";
import Pager from "../components/Pager.astro";
import LifelineMap from "../islands/LifelineMap";
import { lifelinePage as copy, principlesPage } from "../copy/pages";
import { href, t, type Lang } from "../i18n";
import { ui } from "../ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const seams = (await getCollection("seams")).sort((a, b) => a.data.order - b.data.order);
const components = await getCollection("components");
const pad = (n: number) => String(n).padStart(2, "0");
---

<Base lang={lang} title={t(copy.kicker, lang)} description={t(copy.lede, lang)}>
  <PageHead kicker={t(copy.kicker, lang)} title={t(copy.title, lang)} lede={t(copy.lede, lang)} />

  <section class="section">
    <SplitHead title={t(copy.seamsTitle, lang)} lede={t(copy.seamsLede, lang)} />
    <div class="wrap body">
      <Grid cols={3} count={seams.length}>
        {seams.map((s) => <Cell tag={`${pad(s.data.order)} →`} title={s.data.name[lang]} text={`${s.data.claim[lang]}${lang === "zh" ? "。" : "."}`} href={href(`/lifeline/${s.id}/`, lang)} />)}
      </Grid>
    </div>
  </section>

  <section class="section">
    <SplitHead title={t(copy.mapTitle, lang)} lede={t(copy.mapLede, lang)} />
    <div class="wrap body">
      <LifelineMap
        client:visible
        seams={seams.map((s) => ({ id: s.id, order: s.data.order, name: s.data.short[lang], href: href(`/lifeline/${s.id}/`, lang) }))}
        components={components.map((c) => ({
          id: c.id,
          name: c.data.name,
          seam: c.data.seam,
          layer: c.data.layer,
          line: c.data.line[lang],
          repo: c.data.repo,
        }))}
        labels={{
          layers: { human: t(ui.layers.human, lang), agent: t(ui.layers.agent, lang), silent: t(ui.layers.silent, lang) },
          repo: t(ui.repo, lang),
          seamPage: t(copy.seamPage, lang),
        }}
      />
    </div>
  </section>

  <Pager
    prev={{ href: href("/principles/", lang), label: t(ui.previous, lang), title: t(principlesPage.kicker, lang) }}
    next={{ href: href(`/lifeline/${seams[0]!.id}/`, lang), label: `${t(ui.next, lang)} · 01`, title: seams[0]!.data.name[lang] }}
  />
</Base>

<style>
  .body {
    margin-top: clamp(40px, 5vw, 64px);
  }
</style>
