---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import SplitHead from "../components/SplitHead.astro";
import Stage from "../components/Stage.astro";
import Fig from "../components/Fig.astro";
import Pager from "../components/Pager.astro";
import ArtView from "../slices/Art";
import { defaultsPage as copy } from "../copy/pages";
import { href, inlineCode, t, type Lang } from "../i18n";
import { ui } from "../ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const layers = ["human", "agent", "silent"] as const;
const seams = (await getCollection("seams")).sort((a, b) => a.data.order - b.data.order);
const components = await getCollection("components");
const groups = seams
  .map((s) => ({
    seam: s,
    rows: components.flatMap((c) => (c.data.seam === s.id && c.data.defaults ? [{ c, d: c.data.defaults }] : [])),
  }))
  .filter((g) => g.rows.length > 0);
/** The shipped turn check from the demo's step 12, as its file starts (omp-config agent/extensions/turn-judge). */
const example = {
  kind: "code",
  title: "agent/extensions/turn-judge/TURN-JUDGE-gpt-talk-only.md",
  lines: [
    "---",
    "name: gpt-talk-only",
    "target: main",
    "model: (^|/)[Gg][Pp][Tt]",
    "skipTools: wt, harness_restart",
    "inject: user",
    "question.says_remaining: Does `本轮回复` say that some of the assistant's work is still not done, not run, not committed, not pushed or not verified?",
    "…",
    "when.unfinished_with_plan: says_remaining >= 0.6 & announces_future >= 0.3 & asks_user < 0.5 & user_forbids_work < 0.5 & external_blocker < 0.5",
    "prompt: 你停下了，但交代的工作还没做完。不要只宣布下一步或认错：现在就用工具继续做，直到有可验证的结果。…",
    "---",
  ],
} as const;
---

<Base lang={lang} title={t(copy.kicker, lang)} description={t(copy.lede, lang).replaceAll("`", "")}>
  <PageHead kicker={t(copy.kicker, lang)} title={t(copy.title, lang)} lede={t(copy.lede, lang)} />

  <section class="section">
    <SplitHead title={t(copy.exampleTitle, lang)} lede={t(copy.exampleLede, lang)} />
    <div class="wrap body">
      <Stage>
        <div class="example">
          <ArtView lang={lang} art={example} />
          <Fig fig="policy" lang={lang} labels />
        </div>
      </Stage>
    </div>
  </section>

  <section class="section">
    <SplitHead title={t(copy.listTitle, lang)} lede={t(copy.listLede, lang)} />
    <div class="wrap body">
    <ul class="key">
      {
        layers.map((l) => (
          <li class={`layer-${l}`}>
            <span class="layer-dot" />
            {t(ui.layers[l], lang)}
          </li>
        ))
      }
    </ul>
    <div class="table">
      <div class="cols" aria-hidden="true">
        <span class="c-name">{t(copy.component, lang)}</span>
        <span>{t(copy.mechanism, lang)}</span>
        <span>{t(copy.policy, lang)}</span>
      </div>
      {
        groups.map((g) => (
          <section class="group">
            <h2>
              <span class="n">{String(g.seam.data.order).padStart(2, "0")}</span>
              <a href={href(`/lifeline/${g.seam.id}/`, lang)}>{g.seam.data.name[lang]}</a>
            </h2>
            {g.rows.map(({ c, d }) => (
              <div class={`row layer-${c.data.layer}`}>
                <div class="name">
                  <span class="layer-dot" />
                  <code>{c.data.name}</code>
                </div>
                <div class="cell mech">
                  <span class="k">{t(copy.mechanism, lang)}</span>
                  <p set:html={inlineCode(d.mechanism[lang])} />
                </div>
                <div class="cell policy">
                  <span class="k">{t(copy.policy, lang)}</span>
                  <p set:html={inlineCode(d.policy[lang])} />
                </div>
                <a class="go" href={d.customize}>
                  {t(copy.customize, lang)} →
                </a>
              </div>
            ))}
          </section>
        ))
      }
    </div>
    </div>
  </section>

  <Pager
    prev={{ href: href("/products/remote-build/", lang), label: t(ui.previous, lang), title: "omp-remote-build" }}
    next={{ href: "https://github.com/oh-my-omp/omp-config#readme", label: t(copy.start, lang), title: "omp-config" }}
  />
</Base>

<style>
  .body {
    margin-top: clamp(40px, 5vw, 64px);
  }
  .example {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
  }
  .example :global(.sl-art-code pre) {
    font-size: 12px;
  }
  @media (max-width: 900px) {
    .example {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .key {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin: 0 0 20px;
  }
  .key li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 13px;
    color: var(--muted);
  }
  .table {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-raised);
  }
  .cols,
  .row {
    display: grid;
    grid-template-columns: 248px minmax(0, 1.3fr) minmax(0, 1.6fr) 84px;
    grid-template-areas: "name mech policy go";
    column-gap: 24px;
    padding-inline: 20px;
  }
  .cols {
    padding-block: 12px;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dim);
  }
  /* Lines the label up with the pill text: dot width plus the gap after it. */
  .c-name {
    padding-left: 18px;
  }
  h2 {
    display: flex;
    gap: 14px;
    align-items: baseline;
    margin: 0;
    padding: 12px 20px;
    font-size: 16px;
    background: rgb(255 255 255 / 0.025);
    border-block: 1px solid var(--line);
  }
  h2 a:hover {
    color: var(--accent);
  }
  .n {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--accent);
  }
  .row {
    padding-block: 16px;
    align-items: start;
  }
  .row + .row {
    border-top: 1px solid var(--line);
  }
  .name {
    grid-area: name;
    display: flex;
    gap: 10px;
    align-items: center;
    min-height: 26px;
  }
  .name .layer-dot {
    flex: none;
  }
  .name code {
    white-space: nowrap;
  }
  .mech {
    grid-area: mech;
  }
  .policy {
    grid-area: policy;
  }
  .cell p {
    color: var(--muted);
    font-size: 14.5px;
  }
  .policy p {
    color: var(--text);
  }
  .k {
    display: none;
  }
  .go {
    grid-area: go;
    justify-self: end;
    font-size: 13.5px;
    line-height: 26px;
    color: var(--accent);
    white-space: nowrap;
  }
  @media (max-width: 860px) {
    .cols {
      display: none;
    }
    h2 {
      padding-inline: 16px;
    }
    .row {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        "name go"
        "mech mech"
        "policy policy";
      row-gap: 12px;
      padding-inline: 16px;
    }
    .k {
      display: block;
      font-family: var(--mono);
      font-size: 11px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--dim);
      margin-bottom: 2px;
    }
  }
</style>
