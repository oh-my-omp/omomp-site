---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import SplitHead from "../components/SplitHead.astro";
import Stage from "../components/Stage.astro";
import Pager from "../components/Pager.astro";
import ArtView from "../slices/Art";
import { defaultsPage as copy } from "../copy/pages";
import { href, inlineCode, t, type Lang } from "../i18n";
import { ui } from "../ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const layers = ["human", "agent", "silent"] as const;
const seams = (await getCollection("seams")).sort((a, b) => a.data.order - b.data.order);
const components = await getCollection("components");
const groups = seams
  .map((s) => ({
    seam: s,
    rows: components.flatMap((c) => (c.data.seam === s.id && c.data.defaults ? [{ c, d: c.data.defaults }] : [])),
  }))
  .filter((g) => g.rows.length > 0);
/** The component the page-top example belongs to; its chip links to the seam where it acts. */
const exampleComponent = components.find((c) => c.id === "turn-judge");
if (!exampleComponent?.data.defaults) throw new Error("components.yaml has no turn-judge entry with defaults");
const groupId = (seam: string) => `defaults-${seam}`;
/** The shipped turn check whose prompt the demo sends back to the agent, as its file starts (omp-config agent/extensions/turn-judge). */
const example = {
  kind: "code",
  title: "agent/extensions/turn-judge/TURN-JUDGE-gpt-talk-only.md",
  lines: [
    "---",
    "name: gpt-talk-only",
    "target: main",
    "model: (^|/)[Gg][Pp][Tt]",
    "skipTools: wt, harness_restart",
    "inject: user",
    "question.says_remaining: Does `本轮回复` say that some of the assistant's work is still not done, not run, not committed, not pushed or not verified?",
    "…",
    "when.unfinished_with_plan: says_remaining >= 0.6 & announces_future >= 0.3 & asks_user < 0.5 & user_forbids_work < 0.5 & external_blocker < 0.5",
    "prompt: 你停下了，但交代的工作还没做完。不要只宣布下一步或认错：现在就用工具继续做，直到有可验证的结果。…",
    "---",
  ],
} as const;
---

<Base lang={lang} title={t(copy.kicker, lang)} description={t(copy.lede, lang).replaceAll("`", "")}>
  <PageHead kicker={t(copy.kicker, lang)} title={t(copy.title, lang)} lede={t(copy.lede, lang)} />

  <section class="section">
    <SplitHead title={t(copy.exampleTitle, lang)} lede={t(copy.exampleLede, lang)}>
      <div class="chips">
        <a class={`chip layer-${exampleComponent.data.layer}`} href={href(`/lifeline/${exampleComponent.data.seam}/`, lang)}>
          <span class="layer-dot" />
          {exampleComponent.data.name}
        </a>
        <a class="chip text-chip" href={exampleComponent.data.defaults.customize}>{t(copy.exampleDocs, lang)} ↗</a>
      </div>
    </SplitHead>
    <div class="wrap body">
      <Stage>
        <div class="example">
          <div class="source">
            <ArtView lang={lang} art={example} />
            <p class="note" set:html={inlineCode(t(copy.exampleNote, lang))} />
          </div>
          <div class="merge" role="img" aria-label={t(copy.mergeAlt, lang)}>
            <div class="side">
              <p class="who">{t(copy.upstreamLabel, lang)}</p>
              <p class="field changed">
                <span class="f">model:</span>
                <span class="v">(^|/)[Gg][Pp][Tt]</span>
              </p>
              <p class="field">
                <span class="f">prompt:</span>
                <span class="v">你停下了，但交代的工作还没做完。</span>
              </p>
            </div>
            <div class="side">
              <p class="who">{t(copy.baseLabel, lang)}</p>
              <p class="field">
                <span class="f">model:</span>
                <span class="v">[Gg][Pp][Tt]</span>
              </p>
              <p class="field">
                <span class="f">prompt:</span>
                <span class="v">你停下了，但交代的工作还没做完。</span>
              </p>
            </div>
            <div class="side">
              <p class="who">{t(copy.machineLabel, lang)}</p>
              <p class="field">
                <span class="f">model:</span>
                <span class="v">[Gg][Pp][Tt]</span>
              </p>
              <p class="field changed">
                <span class="f">prompt:</span>
                <span class="v">你停下了，但交代的工作还没做完。先跑完测试再停。</span>
              </p>
            </div>
            <p class="via">{t(copy.mergeStep, lang)}</p>
            <div class="side">
              <p class="who">{t(copy.mergedLabel, lang)}</p>
              <p class="field">
                <span class="f">model:</span>
                <span class="v">(^|/)[Gg][Pp][Tt]<span class="from">{t(copy.fromUpstream, lang)}</span></span>
              </p>
              <p class="field">
                <span class="f">prompt:</span>
                <span class="v">你停下了，但交代的工作还没做完。先跑完测试再停。<span class="from">{t(copy.fromMachine, lang)}</span></span>
              </p>
            </div>
            <p class="merge-mech">{t(copy.mergeMechanism, lang)}</p>
          </div>
        </div>
      </Stage>
    </div>
  </section>

  <section class="section">
    <SplitHead title={t(copy.listTitle, lang)} lede={t(copy.listLede, lang)}>
      <nav class="chips" aria-label={t(copy.jumpLabel, lang)}>
        {groups.map((g) => (
          <a class="chip text-chip" href={`#${groupId(g.seam.id)}`}>{g.seam.data.short[lang]}</a>
        ))}
      </nav>
    </SplitHead>
    <div class="wrap body">
      <Stage>
        <div class="index">
          <div class="bar">
            <span class="bar-title">{t(copy.indexTitle, lang)}</span>
            <ul class="key">
              {layers.map((l) => (
                <li class={`layer-${l}`}>
                  <span class="layer-dot" />
                  {t(ui.layers[l], lang)}
                </li>
              ))}
            </ul>
          </div>
          <div class="cols" aria-hidden="true">
            <span class="c-name">{t(copy.component, lang)}</span>
            <span class="c-mech">{t(copy.mechanism, lang)} · {t(copy.fixedTag, lang)}</span>
            <span class="c-policy">{t(copy.policy, lang)} · {t(copy.replaceTag, lang)}</span>
          </div>
          {groups.map((g) => (
            <section class="group" id={groupId(g.seam.id)}>
              <h2>
                <a href={href(`/lifeline/${g.seam.id}/`, lang)}>{g.seam.data.name[lang]} →</a>
              </h2>
              {g.rows.map(({ c, d }) => (
                <div class={`row layer-${c.data.layer}`}>
                  <div class="name">
                    <span class="layer-dot" />
                    <code>{c.data.name}</code>
                  </div>
                  <div class="mech">
                    <span class="k">{t(copy.mechanism, lang)} · {t(copy.fixedTag, lang)}</span>
                    <p set:html={inlineCode(d.mechanism[lang])} />
                  </div>
                  <div class="policy">
                    <span class="k">{t(copy.policy, lang)} · {t(copy.replaceTag, lang)}</span>
                    <p set:html={inlineCode(d.policy[lang])} />
                  </div>
                  <a class="go" href={d.customize}>
                    {t(copy.customize, lang)} ↗
                  </a>
                </div>
              ))}
            </section>
          ))}
        </div>
      </Stage>
    </div>
  </section>

  <Pager
    prev={{ href: href("/products/remote-build/", lang), label: t(ui.previous, lang), title: "omp-remote-build" }}
    next={{ href: "https://github.com/oh-my-omp/omp-config#readme", label: t(copy.start, lang), title: "omp-config" }}
  />
</Base>

<style>
  .body {
    margin-top: clamp(40px, 5vw, 64px);
  }
  .example {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: stretch;
  }
  .source {
    display: grid;
    gap: 14px;
    align-content: start;
  }
  .example :global(.sl-art-code pre) {
    font-size: 12px;
  }
  .note {
    padding-left: 12px;
    border-left: 1px solid var(--line-strong);
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--muted);
  }
  .merge {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 7px;
    min-width: 0;
  }
  .side {
    display: grid;
    gap: 3px;
    padding: 7px 12px;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    background: var(--bg-panel);
  }
  .who {
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .field {
    position: relative;
    display: grid;
    grid-template-columns: 58px minmax(0, 1fr);
    gap: 8px;
    font-family: var(--mono);
    font-size: 12px;
    line-height: 1.45;
  }
  .f {
    color: var(--dim);
  }
  .v {
    color: var(--soft);
    overflow-wrap: anywhere;
  }
  .changed::before {
    content: "";
    position: absolute;
    left: -12px;
    top: 1px;
    bottom: 1px;
    width: 2px;
    border-radius: 1px;
    background: var(--accent);
  }
  .from {
    margin-left: 8px;
    font-size: 11.5px;
    color: var(--accent);
    white-space: nowrap;
  }
  .via {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--muted);
  }
  .via::before,
  .via::after {
    content: "";
    flex: 1;
    border-top: 1px dashed rgb(255 255 255 / 0.22);
  }
  .merge-mech {
    margin-top: 2px;
    padding-top: 8px;
    border-top: 3px solid rgb(255 255 255 / 0.32);
    font-size: 12px;
    color: var(--muted);
  }
  :lang(zh) .who,
  :lang(zh) .via,
  :lang(zh) .merge-mech {
    font-family: var(--sans);
  }
  @media (max-width: 900px) {
    .example {
      grid-template-columns: minmax(0, 1fr);
    }
    .merge {
      justify-content: start;
    }
  }
  /* Chips that carry words rather than a component name. */
  .text-chip {
    font-family: var(--sans);
    font-size: 13px;
  }
  /* The index reads as one panel: a title bar with the layer key, a column header, then one block per seam. */
  .index {
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    background: var(--bg-panel);
    overflow: hidden;
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
    padding: 12px 20px;
    border-bottom: 1px solid var(--line);
  }
  .bar-title {
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--soft);
  }
  .key {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .key li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12.5px;
    color: var(--muted);
  }
  .cols,
  .row {
    display: grid;
    grid-template-columns: 220px minmax(0, 1.2fr) minmax(0, 1.6fr) 72px;
    grid-template-areas: "name mech policy go";
    column-gap: 24px;
    padding-inline: 20px;
  }
  .cols {
    padding-block: 10px;
    font-size: 12.5px;
    color: var(--dim);
    border-bottom: 1px solid var(--line);
  }
  /* Lines the label up with the component names: dot width plus the gap after it. */
  .c-name {
    padding-left: 17px;
  }
  .c-policy,
  .policy .k {
    color: var(--accent);
  }
  .group {
    scroll-margin-top: 88px;
  }
  .group + .group {
    border-top: 1px solid var(--line-strong);
  }
  h2 {
    margin: 0;
    padding: 14px 20px 4px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0;
  }
  h2 a {
    color: var(--soft);
  }
  h2 a:hover {
    color: var(--accent);
  }
  .row {
    padding-block: 12px;
    align-items: start;
  }
  .row + .row {
    border-top: 1px solid var(--line);
  }
  .name {
    grid-area: name;
    display: flex;
    gap: 10px;
    align-items: center;
    min-height: 26px;
  }
  .name .layer-dot {
    flex: none;
  }
  .name code {
    white-space: nowrap;
  }
  .mech {
    grid-area: mech;
  }
  /* The replaceable half carries a thin accent rule, like the changed lines in the merge above. */
  .policy {
    grid-area: policy;
    padding-left: 12px;
    border-left: 2px solid color-mix(in srgb, var(--accent) 55%, transparent);
  }
  .mech p,
  .policy p {
    font-size: 14px;
    line-height: 1.55;
  }
  .mech p {
    color: var(--muted);
  }
  .policy p {
    color: var(--text);
  }
  .k {
    display: none;
  }
  .go {
    grid-area: go;
    justify-self: end;
    font-size: 13px;
    line-height: 26px;
    color: var(--accent);
    white-space: nowrap;
  }
  @media (max-width: 860px) {
    .cols {
      display: none;
    }
    .bar,
    h2 {
      padding-inline: 14px;
    }
    .row {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        "name go"
        "mech mech"
        "policy policy";
      row-gap: 10px;
      padding-inline: 14px;
    }
    .k {
      display: block;
      font-size: 12px;
      color: var(--dim);
      margin-bottom: 2px;
    }
  }
</style>
