---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Pager from "../components/Pager.astro";
import { defaultsPage as copy } from "../copy/pages";
import { href, t, type Lang } from "../i18n";
import { ui } from "../ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const seams = (await getCollection("seams")).sort((a, b) => a.data.order - b.data.order);
const components = await getCollection("components");
const groups = seams
  .map((s) => ({
    seam: s,
    rows: components.flatMap((c) => (c.data.seam === s.id && c.data.defaults ? [{ c, d: c.data.defaults }] : [])),
  }))
  .filter((g) => g.rows.length > 0);
---

<Base lang={lang} title={t(copy.eyebrow, lang)} description={t(copy.lede, lang)}>
  <PageHead eyebrow={t(copy.eyebrow, lang)} title={t(copy.title, lang)} lede={t(copy.lede, lang)} />

  <div class="wrap legend reveal" aria-hidden="true">
    <span>{t(copy.component, lang)}</span>
    <span>{t(copy.mechanism, lang)}</span>
    <span>{t(copy.policy, lang)}</span>
    <span></span>
  </div>

  {
    groups.map((g) => (
      <section class="wrap group reveal">
        <h2>
          <span class="n">{String(g.seam.data.order).padStart(2, "0")}</span>
          <a href={href(`/lifeline/${g.seam.id}/`, lang)}>{g.seam.data.name[lang]}</a>
        </h2>
        <div class="rows">
          {g.rows.map(({ c, d }) => (
            <div class={`row layer-${c.data.layer}`}>
              <div class="cell name">
                <span class="layer-dot" />
                <code>{c.data.name}</code>
              </div>
              <div class="cell">
                <span class="k">{t(copy.mechanism, lang)}</span>
                <p>{d.mechanism[lang]}</p>
              </div>
              <div class="cell policy">
                <span class="k">{t(copy.policy, lang)}</span>
                <p>{d.policy[lang]}</p>
              </div>
              <div class="cell go">
                <a href={d.customize}>{t(copy.customize, lang)} →</a>
              </div>
            </div>
          ))}
        </div>
      </section>
    ))
  }

  <Pager prev={{ href: href("/products/remote-build/", lang), label: t(ui.previous, lang), title: "omp-remote-build" }} />
</Base>

<style>
  .legend,
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr) minmax(0, 1.6fr) 90px;
    gap: 24px;
  }
  .legend {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dim);
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
  }
  .group {
    padding-top: 48px;
  }
  h2 {
    display: flex;
    gap: 14px;
    align-items: baseline;
    font-size: 20px;
    margin-bottom: 8px;
  }
  h2 a:hover {
    color: var(--accent);
  }
  .n {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--accent);
  }
  .row {
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
    align-items: start;
  }
  .name {
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .name .layer-dot {
    flex: none;
  }
  .cell p {
    color: var(--muted);
    font-size: 14.5px;
  }
  .policy p {
    color: var(--text);
  }
  .k {
    display: none;
  }
  .go {
    text-align: right;
    font-size: 13.5px;
  }
  .go a {
    color: var(--accent);
    white-space: nowrap;
  }
  @media (max-width: 860px) {
    .legend {
      display: none;
    }
    .row {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .k {
      display: block;
      font-family: var(--mono);
      font-size: 11px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--dim);
      margin-bottom: 2px;
    }
    .go {
      text-align: left;
    }
  }
</style>
