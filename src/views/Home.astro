---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import HostDiagram from "../components/HostDiagram.astro";
import { home } from "../copy/home";
import { repos, repoUrl, type Repo } from "../data/repos";
import { href, t, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const seams = (await getCollection("seams")).sort((a, b) => a.data.order - b.data.order);
const seamName = new Map(seams.map((s) => [s.id, s.data.name[lang]]));
const seamOrder = new Map(seams.map((s) => [s.id, s.data.order]));
const principles = (await getCollection("principles")).sort((a, b) => a.data.order - b.data.order);

const byKind = (kind: Repo["kind"]) => repos.filter((r) => r.kind === kind);
const runtime = byKind("runtime")[0]!;
const plugins = byKind("plugin");
const products = byKind("product");
const tools = byKind("tool");
---

<Base lang={lang} title={t(home.meta.title, lang)} description={t(home.meta.description, lang)}>
  <section class="hero">
    <div class="glow" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <p class="eyebrow">{t(home.hero.eyebrow, lang)}</p>
      <h1 class="gradient-text">{t(home.hero.title, lang)}</h1>
      <p class="lede">{t(home.hero.lede, lang)}</p>
      <div class="ctas">
        <a class="btn btn-primary" href={href("/lifeline/", lang)}>{t(home.hero.primary, lang)}</a>
        <a class="btn" href={href("/principles/", lang)}>{t(home.hero.secondary, lang)}</a>
      </div>
      <ol class="seam-strip" aria-label={lang === "en" ? "The six seams" : "六个接缝"}>
        {
          seams.map((s) => (
            <li>
              <a href={href(`/lifeline/${s.id}/`, lang)}>
                <span class="n">{String(s.data.order).padStart(2, "0")}</span>
                <span>{s.data.name[lang]}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="band wrap reveal">
    <div class="band-text">
      <p class="eyebrow">{t(home.hosts.eyebrow, lang)}</p>
      <h2>{t(home.hosts.title, lang)}</h2>
      <p class="sub">{t(home.hosts.body, lang)}</p>
    </div>
    <HostDiagram lang={lang} />
  </section>

  <section class="band wrap reveal">
    <div class="band-text">
      <p class="eyebrow">{t(home.modular.eyebrow, lang)}</p>
      <h2>{t(home.modular.title, lang)}</h2>
      <p class="sub">{t(home.modular.body, lang)}</p>
    </div>
    <div class="term">
      <div class="term-bar" aria-hidden="true"><i></i><i></i><i></i></div>
      <pre><code><span class="c"># {lang === "en" ? "one plugin" : "单个插件"}</span>
<span class="p">$</span> omp plugin install https://github.com/oh-my-omp/omp-ask-more

<span class="c"># {lang === "en" ? "the whole runtime" : "整套运行时"}</span>
<span class="p">$</span> git clone https://github.com/oh-my-omp/omp-config
<span class="p">$</span> cd omp-config && omp
<span class="p">&gt;</span> /onboard-omp</code></pre>
    </div>
  </section>

  <section class="wrap blocks reveal" id="blocks">
    <p class="eyebrow">{t(home.blocks.eyebrow, lang)}</p>
    <h2>{t(home.blocks.title, lang)}</h2>

    <h3 class="group">{t(home.blocks.runtime, lang)}</h3>
    <a class="card card-wide" href={repoUrl(runtime.name)}>
      <code class="card-name">{runtime.name}</code>
      <p>{runtime.line[lang]}</p>
      <div class="chips">
        {runtime.seams.map((s) => <span class="chip">{String(seamOrder.get(s)).padStart(2, "0")} {seamName.get(s)}</span>)}
      </div>
    </a>

    <h3 class="group">{t(home.blocks.plugins, lang)}</h3>
    <div class="grid">
      {
        plugins.map((r) => (
          <a class="card" href={repoUrl(r.name)}>
            <code class="card-name">{r.name}</code>
            <p>{r.line[lang]}</p>
            <div class="chips">
              <span class="chip-label">{t(home.blocks.seamLabel, lang)}</span>
              {r.seams.map((s) => (
                <span class="chip">
                  {String(seamOrder.get(s)).padStart(2, "0")} {seamName.get(s)}
                </span>
              ))}
            </div>
          </a>
        ))
      }
    </div>

    <h3 class="group" id="products">{t(home.blocks.products, lang)}</h3>
    <p class="group-sub">{t(home.blocks.productsBody, lang)}</p>
    <div class="grid grid-products">
      {
        products.map((r) => (
          <a class="card card-product" href={href(r.page!, lang)}>
            <code class="card-name">{r.name}</code>
            <p>{r.line[lang]}</p>
            <span class="more">{t(home.blocks.readMore, lang)} →</span>
          </a>
        ))
      }
    </div>

    <h3 class="group">{t(home.blocks.tools, lang)}</h3>
    <div class="tools-row">
      {
        tools.map((r) => (
          <a class="tool" href={repoUrl(r.name)}>
            <code>{r.name}</code>
            <span>{r.line[lang]}</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="wrap tenets reveal">
    <p class="eyebrow">{t(home.principles.eyebrow, lang)}</p>
    <h2>{t(home.principles.title, lang)}</h2>
    <div class="tenet-grid">
      {
        principles.map((p) => (
          <a class="tenet" href={`${href("/principles/", lang)}#${p.id}`}>
            <span class="n">{String(p.data.order).padStart(2, "0")}</span>
            <h3>{p.data.short[lang]}</h3>
            <p>{p.data.summary[lang]}</p>
          </a>
        ))
      }
    </div>
    <a class="link-more" href={href("/principles/", lang)}>{t(home.principles.more, lang)} →</a>
  </section>

  <section class="wrap next reveal">
    <p class="eyebrow">{t(home.next.eyebrow, lang)}</p>
    <h2>{t(home.next.title, lang)}</h2>
    <div class="next-list">
      {
        home.next.items.map((item) => (
          <a href={href(item.route, lang)}>
            <span class="q">{item.q[lang]}</span>
            <span class="a">{item.a[lang]} →</span>
          </a>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }
  .glow {
    position: absolute;
    inset: -40% -10% auto;
    height: 720px;
    background:
      radial-gradient(40% 50% at 50% 40%, rgb(247 168 35 / 0.16), transparent 70%),
      radial-gradient(30% 40% at 75% 30%, rgb(195 177 251 / 0.1), transparent 70%);
    pointer-events: none;
  }
  .hero-inner {
    position: relative;
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 22px;
    padding-top: clamp(80px, 14vw, 160px);
    padding-bottom: 56px;
  }
  .hero h1 {
    font-size: clamp(40px, 7vw, 76px);
    max-width: 960px;
  }
  .lede {
    font-size: clamp(17px, 1.7vw, 21px);
    color: var(--muted);
    max-width: 680px;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 6px;
  }
  .seam-strip {
    list-style: none;
    margin: 56px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    width: 100%;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgb(17 18 22 / 0.7);
    overflow: hidden;
    text-align: left;
  }
  .seam-strip li + li {
    border-left: 1px solid var(--line);
  }
  .seam-strip a {
    display: grid;
    gap: 6px;
    padding: 16px;
    font-size: 13.5px;
    line-height: 1.35;
    color: var(--muted);
    height: 100%;
    transition: background 0.15s, color 0.15s;
  }
  .seam-strip a:hover {
    color: var(--text);
    background: rgb(255 255 255 / 0.03);
  }
  .n {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--accent);
  }
  .band {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
    padding-top: clamp(80px, 12vw, 140px);
  }
  .band-text {
    display: grid;
    gap: 16px;
  }
  h2 {
    font-size: clamp(30px, 4vw, 44px);
  }
  .sub {
    color: var(--muted);
    font-size: 17px;
  }
  .term {
    border: 1px solid var(--line-strong);
    border-radius: 14px;
    background: var(--bg-sunken);
    overflow: hidden;
  }
  .term-bar {
    display: flex;
    gap: 6px;
    padding: 12px 14px;
    border-bottom: 1px solid var(--line);
    background: var(--bg-raised);
  }
  .term-bar i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.12);
  }
  .term pre {
    margin: 0;
    padding: 22px 24px;
    overflow-x: auto;
  }
  .term code {
    background: none;
    border: 0;
    padding: 0;
    font-size: 13.5px;
    line-height: 1.8;
  }
  .term .c {
    color: var(--dim);
  }
  .term .p {
    color: var(--accent);
  }
  .blocks,
  .tenets,
  .next {
    padding-top: clamp(80px, 12vw, 140px);
    display: grid;
    gap: 16px;
  }
  .group {
    margin-top: 36px;
    font-size: 13px;
    font-weight: 500;
    color: var(--dim);
    font-family: var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .group-sub {
    color: var(--muted);
    margin-top: -8px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  .card {
    display: grid;
    align-content: start;
    gap: 12px;
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-raised);
    transition: border-color 0.2s, transform 0.2s, background 0.2s;
  }
  .card:hover {
    border-color: var(--line-strong);
    background: rgb(255 255 255 / 0.025);
    transform: translateY(-2px);
  }
  .card p {
    color: var(--muted);
    font-size: 15px;
  }
  .card-name {
    justify-self: start;
    font-size: 13.5px;
    color: var(--text);
  }
  .card-wide {
    background:
      linear-gradient(120deg, rgb(247 168 35 / 0.08), transparent 50%),
      var(--bg-raised);
  }
  .grid-products .card-product {
    min-height: 200px;
    background:
      radial-gradient(80% 60% at 100% 0%, rgb(195 177 251 / 0.1), transparent 70%),
      var(--bg-raised);
  }
  .card-product p {
    font-size: 17px;
    color: var(--text);
  }
  .more {
    margin-top: auto;
    font-size: 13px;
    color: var(--accent);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
  }
  .chip-label {
    font-size: 12px;
    color: var(--dim);
    margin-right: 2px;
  }
  .chip {
    font-size: 12px;
    color: var(--muted);
    padding: 2px 8px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
  }
  .tools-row {
    display: grid;
    gap: 8px;
  }
  .tool {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: baseline;
    padding: 14px 18px;
    border: 1px solid var(--line);
    border-radius: 10px;
    color: var(--muted);
    font-size: 14.5px;
  }
  .tool:hover {
    border-color: var(--line-strong);
  }
  .tenet-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin-top: 12px;
  }
  .tenet {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 22px;
    border-top: 1px solid var(--line-strong);
  }
  .tenet h3 {
    font-size: 18px;
  }
  .tenet p {
    color: var(--muted);
    font-size: 14.5px;
  }
  .tenet:hover h3 {
    color: var(--accent);
  }
  .link-more {
    font-size: 14px;
    color: var(--accent);
  }
  .next-list {
    display: grid;
    margin-top: 12px;
    border-top: 1px solid var(--line);
  }
  .next-list a {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 22px 4px;
    border-bottom: 1px solid var(--line);
    font-size: clamp(18px, 2vw, 22px);
    transition: padding 0.2s, color 0.2s;
  }
  .next-list a:hover {
    padding-left: 12px;
  }
  .next-list .a {
    color: var(--dim);
    font-size: 15px;
    white-space: nowrap;
  }
  .next-list a:hover .a {
    color: var(--accent);
  }
  @media (max-width: 960px) {
    .seam-strip {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .seam-strip li:nth-child(4) {
      border-left: 0;
    }
    .seam-strip li:nth-child(n + 4) {
      border-top: 1px solid var(--line);
    }
    .band {
      grid-template-columns: 1fr;
    }
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .tenet-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 600px) {
    .seam-strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .seam-strip li {
      border-left: 0 !important;
      border-top: 1px solid var(--line);
    }
    .seam-strip li:nth-child(even) {
      border-left: 1px solid var(--line) !important;
    }
    .seam-strip li:nth-child(-n + 2) {
      border-top: 0;
    }
    .grid,
    .tenet-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
