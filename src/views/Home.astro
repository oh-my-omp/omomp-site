---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import SplitHead from "../components/SplitHead.astro";
import Grid from "../components/Grid.astro";
import Cell from "../components/Cell.astro";
import Fig from "../components/Fig.astro";
import HostStage from "../islands/HostStage";
import ArtView, { type Art } from "../slices/Art";
import ConfigPipeline, { type PipeSeam } from "../slices/ConfigPipeline";
import HomeExecArt from "../slices/HomeExecArt";
import HomeProductArt from "../slices/HomeProductArt";
import type { HookKind } from "../slices/HookMessage";
import { home } from "../copy/home";
import { componentArt, type ComponentId } from "../data/component-art";
import { repos, repoUrl, type Repo } from "../data/repos";
import { sessionQuery } from "../data/seam-stages";
import { href, inlineCode, t, type Lang } from "../i18n";
import { ui } from "../ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const seams = (await getCollection("seams")).sort((a, b) => a.data.order - b.data.order);
const principles = (await getCollection("principles")).sort((a, b) => a.data.order - b.data.order);
const components = await getCollection("components");
const figs = ["append", "signals", "roles", "policy"] as const;
type FigId = (typeof figs)[number];
const isFig = (id: string): id is FigId => (figs as readonly string[]).includes(id);
const isComponent = (id: string): id is ComponentId => id in componentArt;

/** How a silent omp-config component reaches the model, read from the hook its own art quotes. */
const hookOf = (id: string): HookKind | null => {
  if (!isComponent(id)) return null;
  const art = componentArt[id].en;
  return art.kind === "hook" ? art.hook.kind : null;
};

/** omp-config's own components, seam by seam, for the pipeline on its card. */
const pipeline: readonly PipeSeam[] = seams.map((s) => ({
  name: s.data.short[lang],
  items: components
    .filter((c) => c.data.seam === s.id && c.data.repo.includes("/oh-my-omp/omp-config"))
    .map((c) => ({ name: c.data.name, layer: c.data.layer, hook: c.data.layer === "silent" ? hookOf(c.id) : null })),
}));
const pipeLabels = {
  layers: { human: t(ui.layers.human, lang), agent: t(ui.layers.agent, lang), silent: t(ui.layers.silent, lang) },
  kinds: {
    reminder: t(home.blocks.pipeline.kinds.reminder, lang),
    block: t(home.blocks.pipeline.kinds.block, lang),
    judge: t(home.blocks.pipeline.kinds.judge, lang),
  },
  legend: {
    reminder: inlineCode(t(home.blocks.pipeline.legend.reminder, lang)),
    block: inlineCode(t(home.blocks.pipeline.legend.block, lang)),
    judge: inlineCode(t(home.blocks.pipeline.legend.judge, lang)),
  },
};

/** Art slices of a card drawn from component art or written for the card. */
const artsOf = (r: Repo): readonly Art[] => {
  switch (r.art.from) {
    case "component":
      return [componentArt[r.art.id][lang]];
    case "own":
      return r.art.arts[lang];
    case "pipeline":
    case "product":
    case "exec":
      return [];
  }
};
const seamsOf = (r: Repo) =>
  r.seams.length === seams.length
    ? t(home.blocks.allSeams, lang)
    : r.seams.map((id) => seams.find((s) => s.id === id)?.data.short[lang]).join(" · ");
const target = (r: Repo) => (r.page ? href(r.page, lang) : repoUrl(r.name));
const routeHref = (route: string) => (route.startsWith("https://") ? route : href(route, lang));

/** What each way of installing looks like at work. */
const tabArts: Readonly<Record<string, readonly Art[]>> = {
  plugin: [{ kind: "panel", panel: sessionQuery(lang) }],
  config: [componentArt["isolation-nudge"][lang]],
  tern: [componentArt["todo-panel"][lang]],
};
---

<Base lang={lang} title={t(home.meta.title, lang)} description={t(home.meta.description, lang)}>
  <section class="hero wrap">
    <div class="hl">
      <h1>
        <span>{t(home.hero.title[0], lang)}</span>
        <span class="second">{t(home.hero.title[1], lang)}</span>
      </h1>
      <div class="ctas">
        <a class="btn btn-primary" href={href("/replay/", lang)}>{t(home.hero.primary, lang)}</a>
        <a class="btn" href={href("/lifeline/", lang)}>{t(home.hero.secondary, lang)}</a>
      </div>
    </div>
    <p class="lede">{t(home.hero.lede, lang)}</p>
  </section>

  <section class="wrap blocks" aria-label={t(home.blocks.label, lang)}>
    <div class="bento">
      {
        repos.map((r) => (
          <a class={`card k-${r.kind}`} data-repo={r.name} href={target(r)}>
            <div class="ct">
              <div class="meta">
                <code class="name">{r.name}</code>
                <span>
                  {t(home.blocks.kinds[r.kind], lang)}
                  {r.seams.length > 0 && ` · ${seamsOf(r)}`}
                </span>
              </div>
              <p>{t(r.line, lang)}</p>
            </div>
            <div class="ca">
              {r.art.from === "pipeline" && <ConfigPipeline lang={lang} seams={pipeline} labels={pipeLabels} />}
              {r.art.from === "product" && <HomeProductArt lang={lang} id={r.art.id} />}
              {r.art.from === "exec" && <HomeExecArt lang={lang} you={t(home.blocks.exec.you, lang)} agent={t(home.blocks.exec.agent, lang)} />}
              {artsOf(r).map((art) => (
                <ArtView lang={lang} art={art} />
              ))}
            </div>
          </a>
        ))
      }
    </div>
    <p class="bridge">
      <b>{t(home.bridge.lead, lang)}</b>{" "}
      {t(home.bridge.rest, lang)}
    </p>
    <div class="hosts">
      <HostStage
        client:visible
        data={{
          lang,
          omomp: { name: t(home.hosts.omomp.name, lang), role: t(home.hosts.omomp.role, lang) },
          parts: { config: t(home.hosts.parts.config, lang), plugins: t(home.hosts.parts.plugins, lang), products: t(home.hosts.parts.products, lang) },
          hosts: {
            omp: { name: t(home.hosts.hosts.omp.name, lang), role: t(home.hosts.hosts.omp.role, lang) },
            tern: { name: t(home.hosts.hosts.tern.name, lang), role: t(home.hosts.hosts.tern.role, lang) },
          },
          links: { omp: t(home.hosts.links.omp, lang), tern: t(home.hosts.links.tern, lang) },
          install: t(home.hosts.install, lang),
          start: t(home.hosts.start, lang),
          after: t(home.hosts.after, lang),
          tabs: home.hosts.tabs.map((tab) => ({
            id: tab.id,
            label: t(tab.label, lang),
            uses: tab.uses,
            window: t(tab.window, lang),
            arts: tabArts[tab.id] ?? [],
            install: tab.install,
            start: tab.start,
            text: t(tab.text, lang),
            after: tab.after.map((a) => inlineCode(t(a, lang))),
          })),
        }}
      />
    </div>
  </section>

  <section class="section figs">
    <SplitHead title={t(home.principles.title, lang)} lede={t(home.principles.lede, lang)}>
      <a class="more" href={href("/principles/", lang)}>{t(home.principles.more, lang)} →</a>
    </SplitHead>
    <div class="wrap body">
      <Grid cols={2} count={principles.length}>
        {principles.map((p) => {
          if (!isFig(p.id)) throw new Error(`principle \`${p.id}\` has no figure in Fig.astro`);
          return (
            <Cell tag={`FIG 0.${p.data.order}`} title={p.data.short[lang]} text={p.data.summary[lang]} href={href(`/principles/#${p.id}`, lang)}>
              <Fig fig={p.id} lang={lang} />
            </Cell>
          );
        })}
      </Grid>
    </div>
  </section>

  <section class="section last">
    <SplitHead title={t(home.next.title, lang)} />
    <div class="wrap body">
      <ul class="next">
        {
          home.next.items.map((i) => (
            <li>
              <a href={routeHref(i.route)}>
                <span class="q">{t(i.q, lang)}</span>
                <span class="a">{t(i.a, lang)} →</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  /* First screen as supabase.com: a two-line heading and two buttons on the left, a plain three-line lede on
     the right, and the repositories directly below. */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 24px clamp(32px, 5vw, 64px);
    align-items: start;
    padding-top: clamp(40px, 7vw, 100px);
    padding-bottom: clamp(32px, 3.5vw, 44px);
  }
  .hl {
    display: grid;
    gap: 26px;
    justify-items: start;
  }
  .hl h1 {
    display: grid;
    font-size: clamp(34px, 4vw, 52px);
    line-height: 1.08;
  }
  .hl h1 .second {
    color: var(--accent);
  }
  .lede {
    margin-top: 6px;
    font-size: clamp(16px, 1.3vw, 17.5px);
    line-height: 1.6;
    color: var(--muted);
    max-width: 30em;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  /* Bento: a third or less text, the rest a slice of the repository at work. */
  .blocks {
    display: grid;
  }
  .bento {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-flow: row dense;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
  }
  .card {
    grid-column: span 4;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    gap: 16px;
    min-width: 0;
    padding: 22px 22px 0;
    background: var(--bg);
    color: inherit;
    text-decoration: none;
    overflow: hidden;
    transition: background 0.15s;
  }
  .card:hover {
    background: #0c0d0e;
  }
  /* omp-config spans the row: what it is on the left, the pipeline on the right. */
  .card[data-repo="omp-config"] {
    grid-column: 1 / -1;
    grid-template-columns: minmax(0, 5fr) minmax(0, 19fr);
    grid-template-rows: auto;
    gap: 28px;
    padding: 26px 26px 22px;
  }
  /* Wide cards pair with a narrow one on each row: the products, the question page and the image tool. */
  .card[data-repo="omp-ask-more"],
  .card[data-repo="omp-playbooks"],
  .card[data-repo="omp-dispatch"],
  .card[data-repo="omp-remote-build"],
  .card[data-repo="omp-codex-image-gen"] {
    grid-column: span 8;
  }
  /* The question page at width: the brief's three blocks side by side, then the options and the tradeoff card. */
  .card[data-repo="omp-ask-more"] .ca :global(.sl-ask-brief) {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.4em;
  }
  .ct {
    display: grid;
    align-content: start;
    gap: 8px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
    font-size: 12px;
    color: var(--dim);
  }
  .name {
    padding: 0;
    border: 0;
    background: none;
    font-size: 15px;
    color: var(--text);
  }
  .ct p {
    color: var(--muted);
    font-size: 14.5px;
    line-height: 1.55;
    max-width: 30em;
  }
  .ca {
    display: grid;
    align-content: start;
    gap: 10px;
    min-width: 0;
    min-height: 0;
    height: var(--art-h, 330px);
    overflow: hidden;
    mask-image: linear-gradient(to bottom, #000 86%, transparent);
    pointer-events: none;
  }
  /* Drawn whole: the pipeline and the image card end on what they are about. */
  .card[data-repo="omp-config"] .ca,
  .card[data-repo="omp-codex-image-gen"] .ca {
    height: auto;
    mask-image: none;
  }
  /* The question page is drawn whole down to its tradeoff card; the plan beside it gets the same height. */
  .card[data-repo="omp-ask-more"] .ca {
    height: auto;
    mask-image: none;
  }
  .card[data-repo="omp-todo-more"] {
    --art-h: 400px;
  }
  .bridge {
    margin-top: 28px;
    font-size: clamp(19px, 1.9vw, 24px);
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--muted);
    max-width: 52em;
  }
  .bridge b {
    font-weight: 500;
    color: var(--text);
  }
  .hosts {
    margin-top: clamp(32px, 4vw, 48px);
  }
  .body {
    margin-top: clamp(40px, 5vw, 64px);
  }
  /* Two figures a row, each drawn a quarter larger than its canvas so its smallest label reads at body-note size;
     stretched further, the labels would grow past body text. */
  .figs :global(svg.fig) {
    max-width: 300px;
    margin-inline: auto;
  }
  .last {
    padding-bottom: clamp(72px, 10vw, 128px);
  }
  /* Where to go next: question in grey, destination as the link, divided by hairlines. */
  .next {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }
  .next li {
    border-bottom: 1px solid var(--line);
  }
  .next li:not(:nth-child(3n + 1)) {
    border-left: 1px solid var(--line);
  }
  .next a {
    display: grid;
    gap: 6px;
    padding: 22px 24px;
    color: inherit;
    text-decoration: none;
    transition: background 0.15s;
  }
  .next a:hover {
    background: var(--bg-hover);
  }
  .next .q {
    font-size: 14px;
    color: var(--muted);
  }
  .next .a {
    font-size: 17px;
    font-weight: 500;
    color: var(--text);
  }
  @media (max-width: 1080px) {
    .card,
    .card[data-repo="omp-codex-image-gen"] {
      grid-column: span 6;
    }
    .card[data-repo="omp-ask-more"],
    .card[data-repo="omp-playbooks"],
    .card[data-repo="omp-dispatch"],
    .card[data-repo="omp-remote-build"] {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
    }
    .card[data-repo="omp-config"] {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }
    .next {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .next li:not(:nth-child(3n + 1)) {
      border-left: 0;
    }
    .next li:nth-child(2n) {
      border-left: 1px solid var(--line);
    }
  }
  @media (max-width: 680px) {
    .card,
    .card[data-repo] {
      grid-column: 1 / -1;
      padding-bottom: 4px;
    }
    .ca {
      height: var(--art-h, 300px);
    }
    .card[data-repo="omp-ask-more"] .ca :global(.sl-ask-brief) {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.7em;
    }
    /* Stacked on a phone, these slices need their full height to reach the element the caption names. */
    .card[data-repo="omp-dispatch"] .ca,
    .card[data-repo="omp-playbooks"] .ca,
    .card[data-repo="omp-todo-more"] .ca,
    .card[data-repo="omp-remote-build"] .ca {
      height: auto;
      mask-image: none;
    }
    .card[data-repo="omp-unified-exec"] {
      --art-h: 350px;
    }
    .next {
      grid-template-columns: minmax(0, 1fr);
    }
    .next li:nth-child(2n) {
      border-left: 0;
    }
  }
</style>
