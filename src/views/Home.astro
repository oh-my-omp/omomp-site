---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import SplitHead from "../components/SplitHead.astro";
import Grid from "../components/Grid.astro";
import Cell from "../components/Cell.astro";
import Fig from "../components/Fig.astro";
import HostStage from "../islands/HostStage";
import ArtView from "../slices/Art";
import ConfigPipeline from "../slices/ConfigPipeline";
import HookMessage from "../slices/HookMessage";
import Transcript from "../slices/Transcript";
import Window from "../slices/Window";
import { home } from "../copy/home";
import { componentArt } from "../data/component-art";
import { repos, repoUrl, type Repo } from "../data/repos";
import { playerLabels, scenario } from "../data/scenario";
import { href, inlineCode, t, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const seams = (await getCollection("seams")).sort((a, b) => a.data.order - b.data.order);
const principles = (await getCollection("principles")).sort((a, b) => a.data.order - b.data.order);
const figs = ["append", "signals", "roles", "policy"] as const;
type FigId = (typeof figs)[number];
const isFig = (id: string): id is FigId => (figs as readonly string[]).includes(id);

/** The hero shows the demo step where a dispatch is held back: what the person sees beside what the model receives. */
const heroStep = scenario[lang].find((s) => s.hooks.some((h) => h.source === "isolation-nudge"));
if (!heroStep) throw new Error("demo scenario has no isolation-nudge step");
const heroFront = heroStep.front[0];
if (heroFront?.kind !== "transcript") throw new Error("hero step must open with a transcript");
const heroHook = { ...heroStep.hooks[0]!, gloss: undefined };

/** Art slices for a card; the hook pipeline is drawn separately. */
const artsOf = (r: Repo) => {
  switch (r.art.from) {
    case "pipeline":
      return [];
    case "component":
      return [componentArt[r.art.id][lang]];
    case "own":
      return r.art.arts[lang];
  }
};
const seamsOf = (r: Repo) =>
  r.seams.length === seams.length
    ? t(home.blocks.allSeams, lang)
    : r.seams.map((id) => seams.find((s) => s.id === id)?.data.short[lang]).join(" · ");
const target = (r: Repo) => (r.page ? href(r.page, lang) : repoUrl(r.name));
const routeHref = (route: string) => (route.startsWith("https://") ? route : href(route, lang));
---

<Base lang={lang} title={t(home.meta.title, lang)} description={t(home.meta.description, lang)}>
  <section class="hero wrap">
    <div class="hl">
      <p class="kicker">{t(home.hero.kicker, lang)}</p>
      <h1>{t(home.hero.title, lang)}</h1>
      <p class="lede">{t(home.hero.lede, lang)}</p>
      <div class="ctas">
        <a class="btn btn-primary" href={href("/replay/", lang)}>{t(home.hero.primary, lang)}</a>
        <a class="btn" href={href("/lifeline/", lang)}>{t(home.hero.secondary, lang)}</a>
      </div>
    </div>
    <div class="hr" aria-hidden="true">
      <span class="side human">{playerLabels[lang].front}</span>
      <Window tabs={["shop-api"]} meta="omp">
        <div class="hr-screen"><Transcript lines={heroFront.lines} /></div>
      </Window>
      <span class="side silent">{playerLabels[lang].back}</span>
      <HookMessage hook={heroHook} />
    </div>
  </section>

  <section class="wrap blocks" aria-label={t(home.blocks.label, lang)}>
    <div class="bento">
      {
        repos.map((r) => (
          <a class={`card k-${r.kind}`} data-repo={r.name} href={target(r)}>
            <div class="ct">
              <div class="meta">
                <code class="name">{r.name}</code>
                <span>
                  {t(home.blocks.kinds[r.kind], lang)}
                  {r.seams.length > 0 && ` · ${seamsOf(r)}`}
                </span>
              </div>
              <p>{t(r.line, lang)}</p>
            </div>
            <div class="ca">
              {r.art.from === "pipeline" && <ConfigPipeline lang={lang} />}
              {artsOf(r).map((art) => (
                <ArtView lang={lang} art={art} />
              ))}
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section">
    <SplitHead title={t(home.hosts.title, lang)} lede={t(home.hosts.lede, lang)} />
    <div class="wrap body">
      <HostStage
        client:visible
        data={{
          omomp: { name: t(home.hosts.omomp.name, lang), role: t(home.hosts.omomp.role, lang) },
          parts: { config: t(home.hosts.parts.config, lang), plugins: t(home.hosts.parts.plugins, lang), products: t(home.hosts.parts.products, lang) },
          hosts: {
            omp: { name: t(home.hosts.hosts.omp.name, lang), role: t(home.hosts.hosts.omp.role, lang) },
            tern: { name: t(home.hosts.hosts.tern.name, lang), role: t(home.hosts.hosts.tern.role, lang) },
          },
          links: { omp: t(home.hosts.links.omp, lang), tern: t(home.hosts.links.tern, lang) },
          after: t(home.hosts.after, lang),
          tabs: home.hosts.tabs.map((tab) => ({
            id: tab.id,
            label: t(tab.label, lang),
            uses: tab.uses,
            lines: tab.lines,
            text: t(tab.text, lang),
            after: tab.after.map((a) => inlineCode(t(a, lang))),
          })),
        }}
      />
    </div>
  </section>

  <section class="section">
    <SplitHead title={t(home.principles.title, lang)} lede={t(home.principles.lede, lang)}>
      <a class="more" href={href("/principles/", lang)}>{t(home.principles.more, lang)} →</a>
    </SplitHead>
    <div class="wrap body">
      <Grid cols={4} count={principles.length}>
        {principles.map((p) => {
          if (!isFig(p.id)) throw new Error(`principle \`${p.id}\` has no figure in Fig.astro`);
          return (
            <Cell tag={`FIG 0.${p.data.order}`} title={p.data.short[lang]} text={p.data.summary[lang]} href={href(`/principles/#${p.id}`, lang)}>
              <Fig fig={p.id} lang={lang} />
            </Cell>
          );
        })}
      </Grid>
    </div>
  </section>

  <section class="section last">
    <SplitHead title={t(home.next.title, lang)} />
    <div class="wrap body">
      <Grid cols={3} count={home.next.items.length}>
        {home.next.items.map((i) => <Cell tag={t(i.q, lang)} title={`${t(i.a, lang)} →`} text="" href={routeHref(i.route)} />)}
      </Grid>
    </div>
  </section>
</Base>

<style>
  /* First screen: text on the left, a slice of the demo on the right, the repositories just below. */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
    padding-top: clamp(48px, 7vw, 88px);
    padding-bottom: clamp(40px, 5vw, 56px);
  }
  .hl {
    display: grid;
    gap: 20px;
    justify-items: start;
  }
  .hl h1 {
    font-size: clamp(36px, 4.6vw, 56px);
    max-width: 14em;
  }
  .lede {
    font-size: clamp(17px, 1.5vw, 19px);
    color: var(--muted);
    max-width: 34em;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 8px;
  }
  .hr {
    display: grid;
    gap: 10px;
    font-size: 13px;
  }
  .hr-screen {
    padding: 14px;
  }
  .side {
    font-size: 12px;
    color: var(--muted);
  }
  .side::before {
    content: "";
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 8px;
    border-radius: 50%;
    vertical-align: 1px;
  }
  .side.human::before {
    background: var(--human);
  }
  .side.silent {
    margin-top: 6px;
  }
  .side.silent::before {
    background: var(--silent);
  }

  /* Bento: about a third text, the rest a slice of the repository at work. */
  .blocks {
    display: grid;
  }
  .bento {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-rows: minmax(150px, auto);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
  }
  .card {
    grid-column: span 4;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    gap: 18px;
    min-width: 0;
    min-height: 330px;
    padding: 22px 22px 0;
    background: var(--bg);
    color: inherit;
    text-decoration: none;
    overflow: hidden;
    transition: background 0.15s;
  }
  .card:hover {
    background: #0c0d0e;
  }
  .card[data-repo="omp-config"] {
    grid-column: span 6;
    grid-row: span 2;
  }
  .card[data-repo="omp-ask-more"],
  .card[data-repo="omp-todo-more"] {
    grid-column: span 6;
  }
  /* The terminal view needs the width; the thinking card is narrower so both slices end near the same height. */
  .card[data-repo="omp-unified-exec"] {
    grid-column: span 7;
  }
  .card[data-repo="omp-thinking-translator"] {
    grid-column: span 5;
  }
  .ct {
    display: grid;
    gap: 8px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
    font-size: 12px;
    color: var(--dim);
  }
  .name {
    padding: 0;
    border: 0;
    background: none;
    font-size: 15px;
    color: var(--text);
  }
  .ct p {
    color: var(--muted);
    font-size: 14.5px;
    line-height: 1.55;
    max-width: 36em;
  }
  .ca {
    display: grid;
    align-content: start;
    gap: 10px;
    min-height: 0;
    max-height: 300px;
    overflow: hidden;
    mask-image: linear-gradient(to bottom, #000 78%, transparent);
    pointer-events: none;
  }
  /* The pipeline is drawn whole: all six seams fit, so it is neither cut nor faded. */
  .card[data-repo="omp-config"] .ca {
    max-height: none;
    mask-image: none;
  }
  .body {
    margin-top: clamp(40px, 5vw, 64px);
  }
  .last {
    padding-bottom: clamp(72px, 10vw, 128px);
  }
  @media (max-width: 1080px) {
    .card,
    .card[data-repo] {
      grid-column: span 6;
      grid-row: auto;
    }
    .card[data-repo="omp-config"] .ca {
      max-height: 300px;
      mask-image: linear-gradient(to bottom, #000 78%, transparent);
    }
  }
  @media (max-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 680px) {
    .card,
    .card[data-repo] {
      grid-column: 1 / -1;
      min-height: 0;
      padding-bottom: 4px;
    }
    .ca {
      max-height: 240px;
    }
  }
</style>
