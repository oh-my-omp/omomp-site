---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import SplitHead from "../components/SplitHead.astro";
import PreviewHero from "../components/PreviewHero.astro";
import RepairBento from "../components/RepairBento.astro";
import RepairFig from "../components/RepairFig.astro";
import RepairInstall, { type CommandLine, type InstallTab } from "../islands/RepairInstall";
import type { Art } from "../slices/Art";
import { home } from "../copy/home";
import { installStage, preview, repairClose, repairFigs, repairHero } from "../copy/preview";
import { componentArt } from "../data/component-art";
import { sessionQuery } from "../data/seam-stages";
import { emphasis, href, t, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const principles = (await getCollection("principles")).sort((a, b) => a.data.order - b.data.order);
const figs = ["append", "signals", "roles", "policy"] as const;
type FigId = (typeof figs)[number];
const isFig = (id: string): id is FigId => (figs as readonly string[]).includes(id);
const figSummary = (p: (typeof principles)[number]) => {
  const own = repairFigs.summary[p.id];
  return own ? t(own, lang) : p.data.summary[lang];
};

/** What each way of installing looks like at work; the whole set is shown by the call it refuses outright. */
const tabArts: Readonly<Record<string, readonly Art[]>> = {
  plugin: [{ kind: "panel", panel: sessionQuery(lang) }],
  config: [componentArt["delete-guard"][lang]],
  tern: [componentArt["todo-panel"][lang]],
};

/** Install and start as one command block; a line typed inside omp gets a `>` prompt instead of `$`. */
const commandsOf = (install: readonly string[], start: readonly string[]): readonly CommandLine[] => [
  ...install.map((text) => ({ in: text.startsWith("/") ? ("omp" as const) : ("sh" as const), text })),
  { text: "" },
  ...start.map((text) => ({
    in: "sh" as const,
    text: text === "omp-light    # light mode" ? `omp-light    # ${t(installStage.lightComment, lang)}` : text,
  })),
];
const installTabs: readonly InstallTab[] = home.hosts.tabs.map((tab) => ({
  id: tab.id,
  label: t(installStage.tabs[tab.id as keyof typeof installStage.tabs], lang),
  arts: tabArts[tab.id] ?? [],
  commands: commandsOf(tab.install, tab.start),
  note: t(tab.text, lang),
}));
---

<Base lang={lang} title={t(home.meta.title, lang)} description={t(home.meta.description, lang)} noindex>
  <PreviewHero
    lang={lang}
    actions={[
      { label: repairHero.primary, to: "#install" },
      { label: repairHero.secondary, to: "https://github.com/oh-my-omp" },
    ]}
  />
  <section class="wrap blocks" aria-label={t(home.blocks.label, lang)}>
    <RepairBento lang={lang} />
  </section>

  <div class="wrap install" id="install">
    <p class="bridge" set:html={emphasis(t(preview.bridge, lang))} />
    <h2 class="stage-title">
      <span>{t(installStage.title[0], lang)}</span>
      <span>{t(installStage.title[1], lang)}</span>
    </h2>
    <RepairInstall client:visible data={{ lang, label: t(installStage.title[0], lang), tabs: installTabs }} />
  </div>

  <section class="section figs">
    <SplitHead title={t(repairFigs.title, lang)} lede={t(repairFigs.lede, lang)}>
      <a class="more" href={href("/principles/", lang)}>{t(home.principles.more, lang)} →</a>
    </SplitHead>
    <div class="wrap body">
      <div class="figgrid">
        {principles.map((p) => {
          if (!isFig(p.id)) throw new Error(`principle \`${p.id}\` has no figure in RepairFig.astro`);
          return (
            <a class="figcell" href={href(`/principles/#${p.id}`, lang)}>
              <span class="fart">
                <RepairFig fig={p.id} lang={lang} />
              </span>
              <span class="ftxt">
                <span class="ftag">{`FIG 0.${p.data.order}`}</span>
                <span class="ftitle">{p.data.short[lang]}</span>
                <span class="fsum">{figSummary(p)}</span>
              </span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="wrap close">
    <h2>{t(repairClose.title, lang)}</h2>
    <div class="cmd">
      <code><span aria-hidden="true">$ </span>{repairClose.command}</code>
      <button type="button" class="copy" data-copy={repairClose.command} data-done={t(repairClose.copied, lang)}>
        {t(repairClose.copy, lang)}
      </button>
    </div>
    <a class="all" href="https://github.com/oh-my-omp">{t(repairClose.all, lang)} →</a>
  </section>
</Base>

<script>
  // Copy button: put the command on the clipboard and say so on the button for a moment.
  for (const button of document.querySelectorAll<HTMLButtonElement>(".close button.copy")) {
    const label = button.textContent ?? "";
    button.addEventListener("click", async () => {
      await navigator.clipboard.writeText(button.dataset.copy ?? "");
      button.textContent = button.dataset.done ?? label;
      setTimeout(() => (button.textContent = label), 1600);
    });
  }
</script>

<style>
  /* Bridge and install stage on the page grid; the sentence is set like supabase.com's line under its cards. */
  .install {
    margin-top: clamp(48px, 6vw, 80px);
    display: grid;
    gap: clamp(28px, 3vw, 40px);
  }
  /* Two-tone as supabase.com's line under its cards: the claim bright, the rest grey. */
  .bridge {
    font-size: clamp(19px, 1.9vw, 24px);
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--muted);
    max-width: 44em;
  }
  .bridge :global(b) {
    font-weight: inherit;
    color: var(--text);
  }
  .stage-title {
    display: grid;
    margin-bottom: -8px;
    font-size: clamp(22px, 2.2vw, 28px);
    font-weight: 500;
    line-height: 1.25;
  }
  .stage-title span + span {
    color: var(--muted);
  }
  .body {
    margin-top: clamp(40px, 5vw, 64px);
  }

  /* The four rules as on linear.app: one row, cells divided by 1px hairlines, the first cell's text on the heading's
     left edge. */
  .figgrid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-block: 1px solid var(--line);
  }
  .figcell {
    display: grid;
    align-content: start;
    gap: 20px;
    padding: 28px 24px 32px;
    color: inherit;
    text-decoration: none;
    transition: background 0.15s;
  }
  .figcell + .figcell {
    border-left: 1px solid var(--line);
  }
  .figcell:first-child {
    padding-left: 0;
  }
  .figcell:hover {
    background: var(--bg-hover);
  }
  .fart {
    display: block;
  }
  .ftxt {
    display: grid;
    gap: 3px;
  }
  .ftag {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--dim);
  }
  .ftitle {
    font-size: 16px;
    font-weight: 560;
    color: var(--text);
  }
  .fsum {
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--muted);
    max-width: 30em;
  }

  /* The close, as supabase.com ends: one heading, the one command, and the way to the rest. */
  .close {
    display: grid;
    justify-items: start;
    gap: 20px;
    padding-top: clamp(72px, 9vw, 120px);
    padding-bottom: clamp(72px, 10vw, 128px);
  }
  .close h2 {
    font-size: clamp(28px, 3.2vw, 40px);
    font-weight: 500;
  }
  .cmd {
    display: flex;
    align-items: center;
    gap: 12px;
    max-width: 100%;
    padding: 10px 10px 10px 18px;
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    background: var(--bg-raised);
  }
  .cmd code {
    min-width: 0;
    padding: 0;
    border: 0;
    background: none;
    font-size: 13.5px;
    color: var(--soft);
    overflow-wrap: anywhere;
  }
  .cmd code span {
    color: var(--dim);
    user-select: none;
  }
  .copy {
    flex: none;
    height: 28px;
    padding: 0 12px;
    border: 1px solid var(--line-strong);
    border-radius: 7px;
    background: var(--bg);
    color: var(--muted);
    font: inherit;
    font-size: 12.5px;
    cursor: pointer;
  }
  .copy:hover {
    color: var(--text);
  }
  .all {
    font-size: 15px;
    color: var(--muted);
    text-decoration: none;
  }
  .all:hover {
    color: var(--text);
  }

  @media (max-width: 1080px) {
    .figgrid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .figcell:nth-child(3) {
      border-left: 0;
      padding-left: 0;
    }
    .figcell:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }
  @media (max-width: 680px) {
    .figcell {
      gap: 14px;
      padding: 20px 14px 22px;
    }
  }
  /* Chinese headings break only at punctuation, so no word is cut in two. */
  :global(main:lang(zh) h2) {
    word-break: keep-all;
  }
</style>
