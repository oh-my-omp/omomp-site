---
import { getCollection, getEntries } from "astro:content";
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import SplitHead from "../components/SplitHead.astro";
import Stage from "../components/Stage.astro";
import Fig from "../components/Fig.astro";
import Pager from "../components/Pager.astro";
import { principlesPage as copy } from "../copy/pages";
import { href, inlineCode, t, type Lang } from "../i18n";
import { ui } from "../ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const figs = ["append", "signals", "roles", "policy"] as const;
type FigId = (typeof figs)[number];
const isFig = (id: string): id is FigId => (figs as readonly string[]).includes(id);
const principles = await Promise.all(
  (await getCollection("principles"))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (p) => {
      if (!isFig(p.id)) throw new Error(`principle \`${p.id}\` has no figure in Fig.astro`);
      return { ...p, fig: p.id, seen: await getEntries(p.data.seen) };
    }),
);
const figLabel = (order: number) => `FIG 0.${order}`;
const layers = ["human", "agent", "silent"] as const;
---

<Base lang={lang} title={t(copy.kicker, lang)} description={t(copy.lede, lang)}>
  <PageHead kicker={t(copy.kicker, lang)} title={t(copy.title, lang)} lede={t(copy.lede, lang)}>
    <ul class="legend">
      {
        layers.map((layer) => (
          <li class={`layer-${layer}`}>
            <span class="layer-dot" />
            {t(ui.layers[layer], lang)}
          </li>
        ))
      }
    </ul>
  </PageHead>

  {
    principles.map((p) => (
      <section class="section" id={p.id}>
        <div class="wrap fig-kicker">
          <p class="kicker">{figLabel(p.data.order)}</p>
        </div>
        <SplitHead title={p.data.title[lang]} lede={p.data.problem[lang]}>
          <div class="chips" aria-label={t(copy.seen, lang)}>
            {p.seen.map((c) => (
              <a class={`chip layer-${c.data.layer}`} href={href(`/lifeline/${c.data.seam}/`, lang)}>
                <span class="layer-dot" />
                {c.data.name}
              </a>
            ))}
          </div>
        </SplitHead>
        <div class="wrap body">
          <Stage>
            <div class="figure">
              <Fig fig={p.fig} lang={lang} labels dense />
            </div>
          </Stage>
          <ol class="practice">
            {p.data.practice.map((line, i) => (
              <li>
                <h3>{t(copy.practiceTitles[p.fig][i]!, lang)}</h3>
                <p set:html={inlineCode(line[lang])} />
              </li>
            ))}
          </ol>
        </div>
      </section>
    ))
  }

  <Pager
    prev={{ href: href("/", lang), label: t(ui.previous, lang), title: t({ en: "Home", zh: "首页" }, lang) }}
    next={{ href: href("/lifeline/", lang), label: t(ui.next, lang), title: t({ en: "The lifeline", zh: "生命线" }, lang) }}
  />
</Base>

<style>
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 14px;
    color: var(--muted);
  }
  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .fig-kicker {
    padding-bottom: 14px;
  }
  .body {
    display: grid;
    gap: 40px;
    margin-top: clamp(48px, 6vw, 72px);
  }
  .figure {
    width: 100%;
  }
  .practice {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .practice li {
    display: grid;
    align-content: start;
    gap: 8px;
    padding: 4px 28px 4px 24px;
    border-left: 1px solid var(--line);
  }
  .practice li:first-child {
    padding-left: 0;
    border-left: 0;
  }
  .practice p {
    color: var(--muted);
    font-size: 15px;
  }
  @media (max-width: 860px) {
    .practice {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }
    .practice li,
    .practice li:first-child {
      padding: 0 0 0 16px;
      border-left: 1px solid var(--line);
    }
  }
  @media (max-width: 640px) {
    /* The narrow figure fills the stage; drop the side padding that would scale its labels down. */
    .body :global(.canvas) {
      padding-inline: 12px;
    }
  }
</style>
