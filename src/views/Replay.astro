---
import { getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Pager from "../components/Pager.astro";
import ReplayPlayer from "../islands/ReplayPlayer";
import { replayPage as copy } from "../copy/pages";
import { playerLabels, scenario } from "../data/scenario";
import { href, t, type Lang } from "../i18n";
import { ui } from "../ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const delivery = await getEntry("seams", "delivery");
if (!delivery) throw new Error("seam `delivery` missing from seams.yaml");
---

<Base lang={lang} title={t(copy.kicker, lang)} description={t(copy.lede, lang)}>
  <PageHead kicker={t(copy.kicker, lang)} title={t(copy.title, lang)} lede={t(copy.lede, lang)} />
  <section class="wrap player">
    <ReplayPlayer client:load lang={lang} steps={scenario[lang]} labels={playerLabels[lang]} />
  </section>
  <Pager
    prev={{ href: href("/lifeline/delivery/", lang), label: t(ui.previous, lang), title: delivery.data.name[lang] }}
    next={{ href: href("/products/playbooks/", lang), label: t(ui.next, lang), title: "omp-playbooks" }}
  />
</Base>

<style>
  .player {
    padding-bottom: clamp(72px, 10vw, 128px);
  }
</style>
