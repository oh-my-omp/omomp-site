---
import { getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Pager from "../components/Pager.astro";
import ReplayPlayer from "../islands/ReplayPlayer";
import { replayPage as copy } from "../copy/pages";
import { replayIds, replayLabels, shotsFor } from "../data/replay";
import { href, t, type Lang } from "../i18n";
import { ui } from "../ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const shots = shotsFor(replayIds, lang);
const delivery = await getEntry("seams", "delivery");
if (!delivery) throw new Error("seam `delivery` missing from seams.yaml");
---

<Base lang={lang} title={t(copy.eyebrow, lang)} description={t(copy.lede, lang)}>
  <PageHead eyebrow={t(copy.eyebrow, lang)} title={t(copy.title, lang)} lede={t(copy.lede, lang)} />
  <section class="wrap player">
    <ReplayPlayer client:load shots={shots} labels={replayLabels(lang)} />
    <p class="note">{t(copy.note, lang)}</p>
  </section>
  <Pager
    prev={{ href: href("/lifeline/delivery/", lang), label: t(ui.previous, lang), title: delivery.data.name[lang] }}
    next={{ href: href("/products/playbooks/", lang), label: t(ui.next, lang), title: "omp-playbooks" }}
  />
</Base>

<style>
  .player {
    display: grid;
    gap: 16px;
  }
  .note {
    font-size: 13px;
    color: var(--dim);
  }
</style>
