---
import Base from "../layouts/Base.astro";
import PreviewHero from "../components/PreviewHero.astro";
import SplitHead from "../components/SplitHead.astro";
import RealDemo from "../islands/RealDemo";
import { home } from "../copy/home";
import { real } from "../copy/real";
import { moments, realRun as run } from "../data/real-run";
import { repos, repoUrl } from "../data/repos";
import { href, inlineCode, keepNamesWhole, t, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = real.demo;
const products = repos.filter((r) => r.kind === "product");
const plugins = repos.filter((r) => r.kind !== "product");
const productLine = (name: string) => {
  const line = real.products.lines[name];
  if (!line) throw new Error(`product \`${name}\` has no line in src/copy/real.ts`);
  return t(line, lang);
};
const pluginLine = (r: (typeof plugins)[number]) => t(real.products.pluginLines[r.name] ?? r.line, lang);
const provenance = t(d.provenance, lang).replace("{date}", run.date).replace("{omp}", run.omp);
const refused = run.sent.refused;
if (refused.kind !== "refused") throw new Error("the refused moment must record a refused call");
const prompt = { shell: "$", omp: ">" } as const;
---

<Base lang={lang} title={t(home.meta.title, lang)} description={t(home.meta.description, lang)} noindex>
  <PreviewHero
    lang={lang}
    actions={[
      { label: real.hero.primary, to: "#install" },
      { label: real.hero.secondary, to: "/replay/" },
    ]}
  />

  <section class="wrap demo" aria-label={t(d.intro, lang)}>
    <p class="demo-intro">{t(d.intro, lang)}</p>
    <RealDemo
      client:load
      data={{
        lang,
        base: import.meta.env.BASE_URL.replace(/\/$/, ""),
        moments: moments.map((id, i) => ({
          id,
          n: i + 1,
          label: t(d.moments[id].label, lang),
          caption: keepNamesWhole(inlineCode(t(d.moments[id].caption, lang))),
          alt: t(d.moments[id].alt, lang),
          sent: run.sent[id],
          shot: run.shots[id],
        })),
        labels: {
          sent: t(d.sent, lang),
          hidden: t(d.hidden, lang),
          message: t(d.message, lang),
          chars: t(d.chars, lang),
          total: t(d.total, lang),
          quoted: t(d.quoted, lang),
          gloss: t(d.gloss, lang),
          rule: t(d.rule, lang),
          enforced: t(d.enforced, lang),
          args: t(d.args, lang),
          modeUnset: t(d.modeUnset, lang),
        },
        gloss: inlineCode(refused.quote.gloss),
        provenance,
      }}
    />
  </section>

  <section class="section">
    <SplitHead title={t(real.products.title, lang)} lede={t(real.products.lede, lang)} names="whole" />
    <div class="wrap body">
      <ul class="rows">
        {
          products.map((p) => (
            <li>
              <a href={p.page ? href(p.page, lang) : repoUrl(p.name)}>
                <code>{p.name}</code>
                <span>{productLine(p.name)}</span>
                <i aria-hidden="true">→</i>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="plugins-head">{t(real.products.plugins, lang)}</p>
      <ul class="plugins">
        {
          plugins.map((r) => (
            <li>
              <a href={repoUrl(r.name)}>
                <code>{r.name}</code>
                <span>{pluginLine(r)}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section last" id="install">
    <SplitHead title={t(real.install.title, lang)} lede={t(real.install.lede, lang)} names="whole" />
    <div class="wrap body">
      <ol class="ways">
        {
          real.install.ways.map((w) => (
            <li class="way">
              <div class="what">
                <h3>{t(w.title, lang)}</h3>
                <p set:html={inlineCode(t(w.note, lang))} />
              </div>
              <div class="code">
                <div class="pre">
                  {w.lines.map((l) => (
                    <span class="line">
                      <span class="p" aria-hidden="true">{prompt[l.at]}</span>
                      {l.text}
                      {"comment" in l && l.comment && <span class="c">{`  # ${t(l.comment, lang)}`}</span>}
                    </span>
                  ))}
                </div>
                <button
                  type="button"
                  class="copy"
                  data-copy={w.lines.filter((l) => l.at === "shell").map((l) => l.text).join("\n")}
                  data-done={t(real.install.copied, lang)}
                >
                  {t(real.install.copy, lang)}
                </button>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Base>

<script>
  // Copy buttons: put the block's shell lines on the clipboard and say so on the button for a moment.
  for (const button of document.querySelectorAll<HTMLButtonElement>("button.copy")) {
    const label = button.textContent ?? "";
    button.addEventListener("click", async () => {
      await navigator.clipboard.writeText(button.dataset.copy ?? "");
      button.textContent = button.dataset.done ?? label;
      setTimeout(() => (button.textContent = label), 1600);
    });
  }
</script>

<style>
  /* The stage follows the first screen directly, under one plain line, as supabase.com puts its product under the hero. */
  .demo {
    display: grid;
    gap: 16px;
    padding-top: 8px;
    padding-bottom: clamp(64px, 8vw, 104px);
  }
  .demo-intro {
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted);
  }
  /* Chinese headings on this page, the split heads included, break only at punctuation, so no word is cut in two. */
  :global(main:lang(zh) h2),
  :global(main:lang(zh) h3) {
    word-break: keep-all;
  }
  .body {
    margin-top: clamp(36px, 4.5vw, 56px);
  }
  /* Products as rows: name, one line, and the way in. */
  .rows,
  .plugins,
  .ways {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .rows {
    border-top: 1px solid var(--line);
  }
  .rows li {
    border-bottom: 1px solid var(--line);
  }
  .rows a {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 24px;
    padding: 22px 4px;
    color: inherit;
    text-decoration: none;
    transition: background 0.15s;
  }
  .rows a:hover,
  .plugins a:hover {
    background: var(--bg-hover);
  }
  code {
    padding: 0;
    border: 0;
    background: none;
    color: var(--text);
  }
  .rows code {
    font-size: 16px;
  }
  .rows span {
    font-size: 16px;
    color: var(--muted);
  }
  .rows i {
    font-style: normal;
    color: var(--muted);
  }
  /* Plugins as a grid of name and one line, each a link to its repository. */
  .plugins-head {
    margin-top: 44px;
    font-size: 14px;
    color: var(--muted);
  }
  /* Plugins as a two-column list of name and one line, without boxes, as linear.app lists features. */
  .plugins {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 32px;
    margin-top: 12px;
    border-top: 1px solid var(--line);
  }
  .plugins li {
    border-bottom: 1px solid var(--line);
  }
  .plugins a {
    display: grid;
    grid-template-columns: 190px minmax(0, 1fr);
    align-items: baseline;
    gap: 16px;
    height: 100%;
    padding: 14px 4px;
    color: inherit;
    text-decoration: none;
    transition: background 0.15s;
  }
  .plugins code {
    font-size: 14px;
  }
  .plugins span {
    font-size: 14px;
    line-height: 1.55;
    color: var(--muted);
  }
  .plugins span,
  .rows span,
  .what p {
    text-wrap: pretty;
  }
  /* Three ways to install, one row each: what it sets up on the left, the lines to type on the right. */
  .ways {
    border-top: 1px solid var(--line);
  }
  .way {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: 32px;
    padding: 28px 4px;
    border-bottom: 1px solid var(--line);
  }
  .what {
    display: grid;
    align-content: start;
    gap: 10px;
  }
  .what h3 {
    font-size: 17px;
  }
  .what p {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--muted);
  }
  .code {
    position: relative;
    min-width: 0;
  }
  .code .pre {
    padding: 16px 92px 16px 18px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--bg-raised);
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.75;
    color: var(--soft);
    overflow-x: auto;
  }
  .line {
    display: block;
    white-space: pre;
  }
  .p {
    margin-right: 10px;
    color: var(--dim);
    user-select: none;
  }
  .c {
    color: var(--dim);
  }
  .copy {
    position: absolute;
    top: 10px;
    right: 10px;
    height: 28px;
    padding: 0 12px;
    border: 1px solid var(--line-strong);
    border-radius: 7px;
    background: var(--bg);
    color: var(--muted);
    font: inherit;
    font-size: 12.5px;
    cursor: pointer;
  }
  .copy:hover {
    color: var(--text);
  }
  .last {
    padding-bottom: clamp(72px, 10vw, 128px);
  }
  @media (max-width: 1040px) {
    .plugins {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 900px) {
    .way {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }
    /* The copy button moves to its own row above the lines, so it never covers a command. */
    .code {
      display: grid;
      gap: 8px;
    }
    .copy {
      position: static;
      justify-self: end;
      grid-row: 1;
    }
    /* Long commands wrap instead of running off the edge; the continuation hangs under the command, past the prompt. */
    .code .pre {
      padding-right: 18px;
    }
    .line {
      padding-left: calc(1ch + 10px);
      text-indent: calc(-1ch - 10px);
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }
  }
  @media (max-width: 680px) {
    .plugins a {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }
    .rows a {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 6px 16px;
    }
    .rows span {
      grid-column: 1;
      font-size: 15px;
    }
    .rows i {
      grid-row: 1;
      grid-column: 2;
    }
  }
</style>
