---
import { getCollection, type CollectionEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import SplitHead from "../components/SplitHead.astro";
import Grid from "../components/Grid.astro";
import Cell from "../components/Cell.astro";
import Pager from "../components/Pager.astro";
import PlaybooksStage from "../slices/PlaybooksStage";
import DispatchStage from "../slices/DispatchStage";
import RemoteBuildStage from "../slices/RemoteBuildStage";
import { productPage as copy, replayPage, defaultsPage } from "../copy/pages";
import { href, t, type Lang } from "../i18n";
import { ui } from "../ui";

interface Props {
  lang: Lang;
  product: CollectionEntry<"products">;
}
const { lang, product } = Astro.props;
const all = (await getCollection("products")).sort((a, b) => a.data.order - b.data.order);
const index = all.findIndex((p) => p.id === product.id);
const prev = all[index - 1];
const next = all[index + 1];
const stages = { playbooks: PlaybooksStage, dispatch: DispatchStage, "remote-build": RemoteBuildStage } as const;
const isStaged = (id: string): id is keyof typeof stages => id in stages;
if (!isStaged(product.id)) throw new Error(`product \`${product.id}\` has no stage component`);
const StageView = stages[product.id];
const { hub, around } = product.data.roles;
---

<Base lang={lang} title={product.data.name} description={product.data.tagline[lang]}>
  <PageHead kicker={`${t(copy.kicker, lang)} · ${product.data.name}`} title={product.data.tagline[lang]} lede={product.data.intro[lang]}>
    <div class="top">
      <a class="btn" href={product.data.repo}>{t(copy.repo, lang)} ↗</a>
      <nav class="switch" aria-label={t(copy.all, lang)}>
        {all.map((p) => (
          <a href={href(`/products/${p.id}/`, lang)} aria-current={p.id === product.id ? "page" : undefined}>
            {p.data.name}
          </a>
        ))}
      </nav>
    </div>
  </PageHead>

  <section class="wrap stage">
    <StageView lang={lang} />
  </section>

  <section class="section">
    <SplitHead title={t(copy.how, lang)} />
    <div class="wrap body">
      <Grid cols={3} count={product.data.sections.length}>
        {product.data.sections.map((s) => <Cell title={s.title[lang]} text={s.points.map((p) => p[lang]).join(lang === "zh" ? "" : " ")} />)}
      </Grid>
    </div>
  </section>

  <section class="section">
    <SplitHead title={t(copy.who, lang)} />
    <div class="wrap body roles" style={`--n:${around.length}`}>
      <div class="hub">
        <b>{hub.name[lang]}</b>
        <p>{hub.role[lang]}</p>
      </div>
      <div class="spokes" aria-hidden="true">
        {around.map(() => <span />)}
      </div>
      <Grid cols={around.length === 2 ? 2 : 3} count={around.length}>
        {around.map((r) => <Cell title={r.name[lang]} text={r.role[lang]} />)}
      </Grid>
    </div>
  </section>

  <Pager
    prev={prev
      ? { href: href(`/products/${prev.id}/`, lang), label: t(ui.previous, lang), title: prev.data.name }
      : { href: href("/replay/", lang), label: t(ui.previous, lang), title: t(replayPage.kicker, lang) }}
    next={next
      ? { href: href(`/products/${next.id}/`, lang), label: t(ui.next, lang), title: next.data.name }
      : { href: href("/defaults/", lang), label: t(ui.next, lang), title: t(defaultsPage.kicker, lang) }}
  />
</Base>

<style>
  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
    margin-top: 8px;
  }
  .switch {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .switch a {
    padding: 5px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--muted);
    text-decoration: none;
    transition: border-color 0.15s, color 0.15s;
  }
  .switch a:hover {
    color: var(--text);
    border-color: var(--line-strong);
  }
  .switch a[aria-current="page"] {
    color: var(--text);
    border-color: var(--muted);
  }
  .stage {
    padding-bottom: clamp(72px, 10vw, 128px);
  }
  .body {
    margin-top: clamp(40px, 5vw, 64px);
  }

  /* The hub sits above the parties it connects; one hairline drops to each of them. */
  .hub {
    justify-self: center;
    display: grid;
    gap: 6px;
    width: min(100%, 420px);
    padding: 20px 24px;
    border: 1px solid var(--line-strong);
    border-radius: 14px;
    background: var(--bg-raised);
    text-align: center;
  }
  .hub p {
    color: var(--muted);
    font-size: 15px;
  }
  .roles {
    display: grid;
  }
  .spokes {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    height: 48px;
  }
  .spokes::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 0;
    height: 24px;
    border-left: 1px solid var(--line-strong);
  }
  .spokes::after {
    content: "";
    position: absolute;
    top: 24px;
    left: calc(50% / var(--n));
    right: calc(50% / var(--n));
    border-top: 1px solid var(--line-strong);
  }
  .spokes span {
    justify-self: center;
    margin-top: 24px;
    border-left: 1px solid var(--line-strong);
  }
  @media (max-width: 960px) {
    .spokes {
      display: none;
    }
    .hub {
      justify-self: stretch;
      width: auto;
      margin-bottom: 1px;
      text-align: left;
      border-radius: 14px 14px 0 0;
      border-bottom: 0;
    }
  }
</style>
